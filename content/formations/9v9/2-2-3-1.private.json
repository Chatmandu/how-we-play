  "idea": "Two at the back. Wing-backs give width. Three connect us. One leads the line. When the ball changes, our jobs change.",
  "playerFacing": "The formation is where we begin. It isn't where we have to stand. Our wing-backs help us attack but must also help protect our goal.",
  "ruleTable": [
    {
      "n": 1,
      "title": "Two stay connected",
      "say": "Our centre-backs defend together.",
      "question": "Am I close enough to help?"
    },
    {
      "n": 2,
      "title": "Width with cover",
      "say": "Wing-backs go when someone can protect behind.",
      "question": "If I go, who covers?"
    },
    {
      "n": 3,
      "title": "Someone protects the middle",
      "say": "Don't leave the route to our goal open.",
      "question": "Who is stopping the pass through?"
    },
    {
      "n": 4,
      "title": "Lose it? Find home",
      "say": "Press if you can, recover if you can't.",
      "question": "What's the quickest useful defensive job?",
      "lesson": "lose-it-find-home"
    }
  ],
  "considerations": {
    "label": "Hypotheses in the exploratory draft, not reviewed",
    "strengths": [
      "clear width from wing-backs",
      "three players able to combine centrally",
      "one striker stretches play",
      "players experience dual attacking and defending roles"
    ],
    "tradeoffs": [
      "vulnerable spaces behind wide wing-backs",
      "two centre-backs may face two or three attackers",
      "9 can become isolated",
      "central midfielders may block wing-back lanes or fail to cover",
      "the recovery demands may be too great for some teams"
    ]
