// Cloudflare Workers static assets with an API Worker for optional A4 guide email delivery.
// With missing email-service secrets, assets continue to serve direct A4 downloads.
// Build first (npm run build). The build target is chosen from the branch: see docs/DEPLOYMENT.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "how-we-play",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "previews": {}
}
