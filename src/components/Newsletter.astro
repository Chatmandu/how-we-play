---
/* Newsletter band. Until a provider and privacy notice exist (register: coaching-notes.newsletter),
 * public builds show a teaser only; preview builds show the design-system demo form, clearly marked. */
import model from '../lib/content.mjs';
import { newsletterForm } from '../lib/ui.mjs';
const nl = model.items['coaching-notes'].newsletter || {};
const showDemo = model.target !== 'public' && !nl.connected;
const formHtml = showDemo ? newsletterForm({ action: '#', formats: ['3v3', '5v5', '7v7', '9v9', '11v11', 'Other'] }) : '';
---
<section class="news-band" id="newsletter" aria-labelledby="news-h">
  {showDemo ? (
    <div class="flow">
      <h2 class="hwp-sr-only" id="news-h">The Coaching Notes (newsletter demo)</h2>
      <p class="hwp-review-note" role="note"><strong>Demo only.</strong> Nothing you enter is sent, stored or tracked. No email provider is connected and the privacy notice isn't written yet.</p>
      <Fragment set:html={formHtml} />
    </div>
  ) : (
    <div class="news-teaser">
      <h2 class="hwp-heading-m" id="news-h">The Coaching Notes</h2>
      <p class="hwp-small" style="margin:0">An optional email for coaches is planned. Every guide stays free without it. <a href="/coaching-notes/">About the newsletter</a></p>
    </div>
  )}
</section>
