---
/* Team sheet: one formation at a glance. Starting shape, every position with its shirt numbers, and
 * either the four rules (hub) or what the shape gives us (guide). On the pitch, each player is a
 * pointer shortcut to their position; the roster beside it is the keyboard and screen-reader route. */
import { renderPitch, statusChips, esc } from '../lib/ui.mjs';
interface Props { f: any; third?: 'rules' | 'gives'; showHead?: boolean; headingTag?: 'h2' | 'h3'; }
const { f, third = 'rules', showHead = true, headingTag = 'h2' } = Astro.props;
const H = headingTag;
const base = `/formations/9v9/${f.slug}/`;
const full = Array.isArray(f.roles);
const roles = full ? f.roles : (f.roleSummary || []);
const shape = { ...f.shape, title: f.shape.title || `${f.name} starting shape`, altSummary: f.shape.altSummary || f.shape.alt };
let svg = renderPitch(shape, { theme: 'blue', title: shape.title, desc: shape.altSummary });
if (full) {
  const byNum: Record<string, any> = {};
  f.roles.forEach((r: any) => r.nums.forEach((n: string) => { if (!byNum[n]) byNum[n] = r; }));
  svg = svg.replace(/<g data-player="us-([^"]+)">([\s\S]*?)<\/g>/g, (m: string, l: string, inner: string) => {
    const r = byNum[l];
    return r ? `<a href="${base}positions/${r.id}/" tabindex="-1" data-role="${r.id}"><g data-player="us-${l}">${inner}</g></a>` : m;
  });
}
const rules = full ? f.rules : (f.ruleTable || []);
const sheetId = `sheet-${f.slug}`;
---
<section class="sheet ed-grid" aria-labelledby={showHead ? `${sheetId}-h` : undefined} aria-label={showHead ? undefined : `${f.name} team sheet`} data-sheet>
  {showHead && (
    <div class="sheet__head">
      <H class="sheet__name" id={`${sheetId}-h`}><small>Team sheet · 9v9 · {f.notation}</small><a href={base}>{f.name}</a></H>
      <div class="sheet__intro">
        <p class="ed-stand">{full ? 'One possible way to play 9v9: a starting shape, four rules and a job for every position.' : f.idea}</p>
        <div class="ed-chips" set:html={statusChips(f.register)} />
      </div>
    </div>
  )}
  <figure class="sheet__pitch on-pitch">
    <Fragment set:html={svg} />
    <figcaption>{f.shapeCue || f.shape.caption || f.playerFacing}</figcaption>
  </figure>
  <div class="sheet__col sheet__col--roles">
    <h3>Positions</h3>
    <ol class="roster">
      {roles.map((r: any) => full ? (
        <li><a href={`${base}positions/${r.id}/`} data-role-row={r.id}><span class="nums">{r.nums.join(' · ')}</span><span><strong>{r.title}</strong><span>{r.head}</span></span><span class="arr" aria-hidden="true">→</span></a></li>
      ) : (
        <li><div class="row"><span class="nums">{r.nums.join(' · ')}</span><span><strong>{r.title}</strong><span>{r.head}</span></span><span></span></div></li>
      ))}
    </ol>
  </div>
  <div class="sheet__col sheet__col--third">
    {third === 'rules' ? (
      <>
        <h3>Four rules</h3>
        <ol class="rulelist">
          {rules.map((r: any) => {
            const href = full ? `${base}${r.id}/` : (r.lesson ? `${base}${r.lesson}/` : null);
            const inner = <><b>Rule {r.n}</b><strong>{r.title}</strong><i>{full ? r.cue : r.say}</i></>;
            return <li>{href ? <a href={href}>{inner}</a> : <div class="row">{inner}</div>}</li>;
          })}
        </ol>
      </>
    ) : (
      <>
        <h3>This shape gives us</h3>
        <ul class="gives">{(f.gives || []).map((g: string) => <li>{g}</li>)}</ul>
        {f.spineText && <p class="ed-small sheet__note"><strong>Our spine</strong> runs through the middle: {f.spineText}.</p>}
      </>
    )}
  </div>
</section>
<script>
  /* Hovering a player on the pitch lights the matching row in the roster, and the other way round. */
  document.querySelectorAll('[data-sheet]').forEach(sheet => {
    const light = (id: string | undefined, on: boolean) => { if (!id) return; sheet.querySelectorAll(`[data-role="${id}"], [data-role-row="${id}"]`).forEach(n => n.classList.toggle('lit', on)); };
    sheet.querySelectorAll<HTMLElement>('[data-role], [data-role-row]').forEach(n => {
      const id = n.dataset.role || n.dataset.roleRow;
      ['mouseenter', 'focus'].forEach(ev => n.addEventListener(ev, () => light(id, true)));
      ['mouseleave', 'blur'].forEach(ev => n.addEventListener(ev, () => light(id, false)));
    });
  });
</script>
