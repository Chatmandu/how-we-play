---
/* "Found this useful?" Voluntary Ko-fi support, used at the end of formation issues only. No widgets, no pop-ups. */
import model from '../lib/content.mjs';
const k = model.site.support;
---
<aside class="support ed-grid" aria-labelledby="support-h">
  <div class="support__in">
    <div class="support__copy">
      <p class="support__eyebrow">Keep grassroots football free</p>
      <h2 class="support__h" id="support-h">Found this useful?</h2>
      <p>How We Play Football is an independent project sharing free football coaching guides and practical ideas from the grassroots touchline.</p>
      <p>If something we've created has helped you or your team, you can buy me a coffee to support the next guide.</p>
    </div>
    <div class="support__action">
      <a class="support__button" href={k.kofi} rel="noopener noreferrer" target="_blank" data-support="issue">Buy me a coffee <span aria-hidden="true">↗</span><span class="hwp-sr-only"> on Ko-fi (opens in a new tab)</span></a>
      <p>No pressure. The standard resources are free for everyone.</p>
    </div>
  </div>
</aside>
