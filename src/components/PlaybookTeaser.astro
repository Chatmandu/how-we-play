---
/* An editorial picture of what's in the printable guide, using the reviewed formation diagram.
 * This isn't presented as the PDF's literal cover. */
interface Props { name: string; format: string; shapeImage?: string | null; }
const { name, format, shapeImage } = Astro.props;
---
<figure class="playbook-teaser">
  <div class="playbook-teaser__cover">
    <div class="playbook-teaser__bar">
      <span>HOW WE PLAY / FOOTBALL</span>
      <span>A4 · FREE</span>
    </div>
    <p class="playbook-teaser__eyebrow">COACH'S PLAYBOOK</p>
    <p class="playbook-teaser__shape">{name}</p>
    {shapeImage ? (
      <img class="playbook-teaser__pitch" src={shapeImage} alt={'The ' + name + ' starting-shape diagram included in this ' + format + ' guide'} width="500" height="310" loading="lazy">
    ) : (
      <p class="playbook-teaser__placeholder">STARTING SHAPE · COACHING PRINCIPLES · PLAYER ROLES</p>
    )}
    <p class="playbook-teaser__foot">{format} FORMATION GUIDE</p>
  </div>
  <figcaption>One practical reference for training, matchday and sharing with the team.</figcaption>
</figure>
<style>
  .playbook-teaser { grid-column: 1 / span 5; margin: 0; max-width: 470px; width: 100%; }
  .playbook-teaser__cover {
    background: #fff; color: var(--hwp-color-ink);
    border: 1.5px solid var(--hwp-color-ink);
    border-bottom: 9px solid var(--hwp-color-pitch-blue);
    box-shadow: 8px 8px 0 var(--hwp-color-ink);
    padding: clamp(16px, 2vw, 24px); box-sizing: border-box;
  }
  .playbook-teaser__bar { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin: -1px 0 24px; padding-bottom: 11px; border-bottom: 1px solid var(--hwp-color-rule); font: 800 11px/1.2 var(--ed-display); letter-spacing: .09em; }
  .playbook-teaser__eyebrow { margin: 0 0 5px; font: 700 11px/1.2 var(--ed-sans); letter-spacing: .1em; color: var(--hwp-color-pitch-blue); }
  .playbook-teaser__shape { margin: 0 0 18px; font: 900 clamp(56px, 6vw, 85px)/.82 var(--ed-display); letter-spacing: -.015em; }
  .playbook-teaser__pitch { width: 100%; max-height: 270px; height: auto; object-fit: contain; display: block; }
  .playbook-teaser__placeholder { margin: 0; min-height: 190px; display: grid; align-content: center; font: 800 20px/1.3 var(--ed-display); }
  .playbook-teaser__foot { margin: 16px 0 0; padding-top: 10px; border-top: 1px solid var(--hwp-color-rule); font: 800 12px/1.2 var(--ed-display); letter-spacing: .1em; }
  figcaption { margin: 19px 12px 0 0; font: 500 14px/1.5 var(--ed-sans); color: var(--hwp-text-secondary); }
  @media (max-width: 1023px) { .playbook-teaser { grid-column: 1 / span 3; } .playbook-teaser__shape { font-size: 62px; } }
  @media (max-width: 599px) { .playbook-teaser { grid-column: 1 / -1; margin-bottom: 18px; max-width: 360px; } .playbook-teaser__cover { box-shadow: 6px 6px 0 var(--hwp-color-ink); } .playbook-teaser__shape { font-size: 58px; } .playbook-teaser__pitch { max-height: 210px; } }
</style>
