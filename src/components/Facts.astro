---
/* Official rule facts with their verification chip and source link (editor track).
 * mode "compare" shows 7v7 → 9v9 values; mode "list" shows the fact sentence. */
import model from '../lib/content.mjs';
import { longDate } from '../lib/ui.mjs';
interface Props { ids: string[]; mode?: 'compare' | 'list'; caption?: string; }
const { ids, mode = 'list', caption } = Astro.props;
const facts = ids.map(id => model.fact(id));
const sources = [...new Map(facts.map(f => [f.source, f.sourceInfo])).values()];
const checked = [...new Set(facts.map(f => f.checkedOn))];
const kinds = new Set(facts.map(f => f.kind));
---
<div class="flow" data-hwp-facts={ids.join(' ')}>
  {mode === 'compare' ? (
    <dl class="facts" aria-label={caption}>
      {facts.map(f => (
        <div><dt>{f.fact}</dt><dd>{f.v7 === f.v9 ? <>{f.v9} <span class="was">(no change)</span></> : <><span class="was">{f.v7} →</span> {f.v9}</>}</dd></div>
      ))}
    </dl>
  ) : (
    <ul class="list">{facts.map(f => <li>{f.fact}{f.v9 ? <>: <strong>{f.v9}</strong></> : ''}</li>)}</ul>
  )}
  <div class="rule-source">
    <span class="hwp-chip hwp-chip--verified">{kinds.has('rule') ? 'Official rule verified' : 'FA guidance checked'} · {checked.map(longDate).join(', ')}</span>
    <ul class="rule-sources" aria-label="Sources">{sources.map(s => <li><a href={s.url} rel="noopener" target="_blank">{s.publisher}: {s.title}<span class="hwp-sr-only"> (opens in a new tab)</span></a></li>)}</ul>
    <span class="hwp-secondary">Season {facts[0].season}. Check with your league for local rules.</span>
  </div>
</div>
