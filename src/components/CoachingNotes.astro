---
/* The Coaching Notes: the one newsletter signup, rendered once in the global footer (Base.astro).
 * Posts to the Mailchimp embedded-form action in content/site.json. With JavaScript it submits through
 * Mailchimp's JSON endpoint so the reader stays on the page and sees the real result; without it the form
 * posts to Mailchimp in a new tab. No Mailchimp script loads until someone submits. Until an action URL is
 * configured, public builds show no form (preview builds show the design, marked as not connected). */
import model from '../lib/content.mjs';
const nl = model.site.newsletter || {};
const action = nl.action ? String(nl.action).replace(/&amp;/g, '&').trim() : null;  // embed code pastes &amp;
const preview = model.target !== 'public';
const show = !!action || preview;
// Mailchimp's honeypot field is named b_<u>_<id> from the same action URL.
const hp = action ? (() => { try { const u = new URL(action); return `b_${u.searchParams.get('u')}_${u.searchParams.get('id')}`; } catch { return null; } })() : null;
---
{show && (
  <section class="cn" id="the-coaching-notes" aria-labelledby="cn-h">
    <div class="ed-wrap cn__in">
      <div class="cn__text">
        <p class="cn__name">{nl.name || 'The Coaching Notes'}</p>
        <h2 class="cn__h" id="cn-h">A little help from the touchline.</h2>
        <p class="cn__dek">New formation guides, coaching ideas and practical resources from How We Play. Straight to your inbox, occasionally. No unnecessary emails.</p>
      </div>
      <form class="cn__form" action={action || '#'} method="post" target="_blank" novalidate data-cn={action ? 'live' : 'unconnected'}>
        <label class="cn__label" for="cn-email">Your email address</label>
        <div class="cn__row">
          <input class="cn__input" id="cn-email" name="EMAIL" type="email" autocomplete="email" inputmode="email" required aria-describedby="cn-help cn-status" spellcheck="false">
          <button class="cn__btn" type="submit">Sign up</button>
        </div>
        {hp && <div class="cn__hp" aria-hidden="true"><input type="text" name={hp} tabindex="-1" value=""></div>}
        <p class="cn__help" id="cn-help">Free to subscribe. Unsubscribe whenever you like.{nl.doubleOptIn ? " We'll email you to confirm first." : ''} By signing up you agree to receive The Coaching Notes; see our <a href="/privacy/#newsletter">privacy notice</a>.</p>
        <p class="cn__status" id="cn-status" role="status" aria-live="polite">{!action && preview ? 'Preview only: no Mailchimp form is connected yet, so nothing is sent.' : ''}</p>
        <p class="cn__captcha" data-cn-captcha-wrap hidden><a class="cn__verify" data-cn-captcha-link href="#" target="_blank" rel="noopener noreferrer">Complete security check with Mailchimp ↗</a></p>
      </form>
    </div>
  </section>
)}
<script>
  import { track } from '../scripts/analytics.mjs';
  import { mailchimpCaptchaUrl } from '../lib/mailchimp-captcha.mjs';
  const form = document.querySelector<HTMLFormElement>('form[data-cn]');
  if (form) {
    const input = form.querySelector<HTMLInputElement>('input[type=email]')!;
    const status = form.querySelector<HTMLElement>('.cn__status')!;
    const btn = form.querySelector<HTMLButtonElement>('button')!;
    const captchaWrap = form.querySelector<HTMLElement>('[data-cn-captcha-wrap]')!;
    const captchaLink = form.querySelector<HTMLAnchorElement>('[data-cn-captcha-link]')!;
    const hideCaptcha = () => { captchaWrap.hidden = true; captchaLink.removeAttribute('href'); };
    const say = (msg: string, kind = '') => { status.textContent = msg; status.dataset.kind = kind; };
    const valid = (v: string) => /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v);
    const clean = (html: string) => { const d = document.createElement('div'); d.innerHTML = html; return (d.textContent || '').replace(/^\d+\s*-\s*/, '').trim(); };
    form.addEventListener('submit', e => {
      e.preventDefault();
      hideCaptcha();
      const email = input.value.trim();
      if (!valid(email)) { input.setAttribute('aria-invalid', 'true'); say('Please enter a valid email address, like name@example.com.', 'error'); input.focus(); return; }
      input.removeAttribute('aria-invalid');
      if (form.dataset.cn !== 'live') { say('Preview only: no Mailchimp form is connected yet, so nothing was sent.', 'error'); return; }
      track('newsletter_submit', { form_location: 'footer' });
      btn.disabled = true; say('Signing you up…');
      // Mailchimp's JSON endpoint for embedded forms. Only the email (and the empty honeypot) are sent, and only to Mailchimp.
      const cb = 'cn_cb_' + Date.now();
      const url = new URL(form.action.replace('/post?', '/post-json?'));
      new FormData(form).forEach((v, k) => url.searchParams.set(k, String(v)));
      url.searchParams.set('c', cb);
      const s = document.createElement('script');
      const done = () => { btn.disabled = false; s.remove(); delete (window as any)[cb]; clearTimeout(t); };
      const t = setTimeout(() => { done(); say("We couldn't reach the signup service. Please try again in a moment.", 'error'); track('newsletter_error', { reason: 'timeout' }); }, 12000);
      (window as any)[cb] = (r: { result: string; msg: string; params?: Record<string, string | number> }) => {
        done();
        if (r && r.msg === 'captcha') {
          // Mailchimp requests a human check and returns parameters for its
          // own hosted verification page. Keep that challenge enabled.
          const verification = mailchimpCaptchaUrl(form.action, r.params);
          if (verification) {
            captchaLink.href = verification;
            captchaWrap.hidden = false;
            say('One more step: Mailchimp needs to verify you are a person. Use the link below to complete your signup.', 'error');
          } else {
            say("Mailchimp needs a security check, but we couldn't open it. Please try again or contact us.", 'error');
          }
          track('newsletter_verification_required', { form_location: 'footer' });
        } else if (r && r.result === 'success') {
          form.reset();
          say("Nearly there. Check your inbox and confirm your email to start receiving The Coaching Notes.", 'ok');
          track('newsletter_signup', { form_location: 'footer', status: 'pending_confirmation' });
        } else {
          const m = clean((r && r.msg) || '');
          say(/already subscribed/i.test(m) ? "You're already on the list. Thanks!" : (m || "Something went wrong. Please try again."), 'error');
          track('newsletter_error', { reason: /already subscribed/i.test(m) ? 'already_subscribed' : 'rejected' });
        }
      };
      s.src = url.toString(); s.onerror = () => { done(); say("We couldn't reach the signup service. Please try again in a moment.", 'error'); track('newsletter_error', { reason: 'network' }); };
      document.body.appendChild(s);
    });
  }
</script>
