---
/* Base page layout: metadata, header, footer, design-system styles and behaviours.
 * Every page passes `ids` (register ids it is built from). The layout asks the publishing gate
 * whether the page may exist for this target and whether it must be marked private and noindex. */
import '../../design-system/tokens/tokens.css';
import '../../design-system/css/foundations.css';
import '../../design-system/diagrams/diagram.css';
import '../../design-system/components/components.css';
import '../styles/fonts.css';
import '../styles/site.css';
import '../styles/editorial.css';
import model from '../lib/content.mjs';
import { breadcrumbs, privateStrip, ASSET_BASE } from '../lib/ui.mjs';
import CoachingNotes from '../components/CoachingNotes.astro';
import Consent from '../components/Consent.astro';
import { socialImageForRoute } from '../lib/social-images.mjs';

interface Crumb { label: string; href?: string }
interface Props {
  title: string;            // full <title> (SEO title)
  description: string;      // meta description
  ids?: string[];           // register ids this page depends on
  crumbs?: Crumb[];         // breadcrumbs, last item is the current page
  nav?: string;             // main navigation item to mark current
  activeFormat?: string;
  ogType?: 'website' | 'article';
  jsonLd?: object[];
  noindex?: boolean;
  editorial?: boolean;
  meta?: { type?: string; format?: string; issue?: number; formation?: string; group?: string };  // analytics page metadata (no personal data)      // editorial pages own their grid; others sit in the standard container
}
const { title, description, ids = [], crumbs = [], nav, activeFormat, ogType = 'article', jsonLd = [], noindex = false, editorial = false, meta = {} } = Astro.props;

const access = model.access(ids);
if (!access.allowed) {
  // A page must never be generated for a target its content is blocked from. getStaticPaths should
  // already have filtered it; failing here makes the mistake loud instead of silent.
  throw new Error(`Publishing gate: ${Astro.url.pathname} is blocked for ${model.target}: ${access.reasons.join('; ')}`);
}
const site = model.site;
const isPublic = model.target === 'public';
const robots = noindex || access.noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
const canonical = new URL(Astro.url.pathname, site.url).href;
const visual = socialImageForRoute(Astro.url.pathname, model);
const ogImage = new URL(visual.image, site.url).href;
const ogImageAlt = visual.alt;

/* Primary navigation: the playing formats (11v11 stays out until it has content). Secondary: supporting sections.
 * A format still in development keeps its link, which leads to an honest, noindex placeholder with a way back. */
const formatNav = ['5v5', '7v7', '9v9'].map(id => { const fm = site.formats.find(x => x.id === id); return { id, label: id, href: `/formations/${id}/`, soon: fm && fm.availability !== 'live' }; });
const navItems = [
  { id: 'about', label: 'About', href: '/about/' }
];
const footLinks = [
  ...formatNav.map(x => ({ label: `${x.label} formations`, href: x.href })),
  { label: 'About and standards', href: '/about/' }, { label: 'Privacy and cookies', href: '/privacy/' }
];
const socialLinks = [
  { key: 'instagram', label: 'Instagram' },
  { key: 'tiktok', label: 'TikTok' },
  { key: 'youtube', label: 'YouTube' }
].filter(x => site.social?.[x.key]?.url).map(x => ({ ...x, url: site.social[x.key].url }));

const crumbLd = crumbs.length ? [{
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.label, item: new URL(c.href || Astro.url.pathname, site.url).href }))
}] : [];
const ld = [...crumbLd, ...jsonLd];
const pageItems = ids.join(' ');
---
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {isPublic && <meta name="msvalidate.01" content="09ABE7DAF08C80C9C7AE9E2C6813BDEA">}
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="robots" content={robots}>
  <link rel="canonical" href={canonical}>
  {isPublic && <link rel="alternate" type="application/rss+xml" title="How We Play: new formation issues" href="/feed.xml">}
  <meta property="og:site_name" content={site.name}>
  <meta property="og:type" content={ogType}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:secure_url" content={ogImage}>
  <meta property="og:image:type" content="image/png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content={ogImageAlt}>
  <meta property="og:locale" content={site.locale}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>
  <meta name="twitter:image:alt" content={ogImageAlt}>
  <link rel="icon" href={`${ASSET_BASE}favicon/favicon.svg`} type="image/svg+xml">
  <link rel="icon" href={`${ASSET_BASE}favicon/favicon-32.png`} sizes="32x32" type="image/png">
  <link rel="apple-touch-icon" href={`${ASSET_BASE}favicon/apple-touch-icon.png`}>
  <link rel="manifest" href={`${ASSET_BASE}favicon/site.webmanifest`}>
  <meta name="theme-color" content="#F2EDE2">
  <link rel="preload" href="/fonts/big-shoulders-display-latin-900-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/schibsted-grotesk-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  {ld.map(o => <script type="application/ld+json" set:html={JSON.stringify(o).replace(/</g, '\\u003c')} />)}
</head>
<body data-hwp-type={meta.type} data-hwp-format={meta.format} data-hwp-issue={meta.issue} data-hwp-formation={meta.formation} data-hwp-group={meta.group} data-target={model.target} data-hwp-items={pageItems} data-hwp-private={access.private ? 'true' : undefined}>
  <a class="skip-link" href="#main">Skip to content</a>
  {!isPublic && (
    <aside class="preview-banner" aria-label="Preview notice" set:html={privateStrip().replace('Private preview · not for publication', `Private preview build (${model.target}) · not for publication · not indexed`)} ></aside>
  )}
  <header class="mast">
    <div class="ed-wrap mast__bar">
      <a class="mast__logo" href="/"><img src={`${ASSET_BASE}logo/hwp-lockup-inline.svg`} alt="How We Play, home" width="180" height="28"></a>
      <p class="mast__issue">A grassroots football coaching publication</p>
      <button class="mast__menu" type="button" aria-expanded="false" aria-controls="mast-nav" hidden><svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M2 5h16M2 10h16M2 15h16" stroke="currentColor" stroke-width="2"/></svg>Menu</button>
      <nav class="mast__nav" id="mast-nav" aria-label="Main">
        <span class="mast__formats" role="group" aria-label="Playing formats">{formatNav.map(i => <a class="mast__fmt" href={i.href} aria-current={i.id === nav ? 'page' : undefined}>{i.label}{i.soon && <span class="mast__soon"> · in development</span>}</a>)}</span>
        <span class="mast__more" role="group" aria-label="Sections">{navItems.map(i => <a href={i.href} aria-current={i.id === nav ? 'page' : undefined}>{i.label}</a>)}</span>
      </nav>
    </div>
  </header>
  <main id="main" class={editorial ? 'ed-main' : 'site-main hwp-container'} tabindex="-1">
    {crumbs.length > 0 && (editorial
      ? <div class="ed-wrap ed-crumbs"><Fragment set:html={breadcrumbs(crumbs.map(c => ({ label: c.label, href: c.href })))} /></div>
      : <Fragment set:html={breadcrumbs(crumbs.map(c => ({ label: c.label, href: c.href })))} />)}
    <slot />
  </main>
  <footer class="foot">
    <CoachingNotes />
    <div class="ed-wrap foot__grid">
      <a class="foot__logo" href="/"><img src={`${ASSET_BASE}logo/hwp-lockup-inline-reverse.svg`} alt="How We Play, home" width="180" height="28"></a>
      <div class="foot__links">
        <nav class="foot__nav" aria-label="Footer">{footLinks.map(l => <a href={l.href}>{l.label}</a>)}<button type="button" class="foot__cookie" data-cookie-settings>Cookie settings</button><a class="foot__support" href={site.support.kofi} rel="noopener noreferrer" target="_blank" data-support="footer">{site.support.label}<span class="hwp-sr-only"> on Ko-fi (opens in a new tab)</span></a></nav>
        <nav class="foot__social" aria-label="Follow How We Play">{socialLinks.map(l => <a href={l.url} rel="me noopener noreferrer" target="_blank">{l.label}<span aria-hidden="true"> ↗</span><span class="hwp-sr-only"> (opens in new tab)</span></a>)}</nav>
      </div>
      <p class="foot__note">{site.independence || 'How We Play is an independent project. It is not affiliated with or endorsed by The FA or England Football.'} Official rules link to their source with the date we checked them.</p>
    </div>
  </footer>
  <Consent />
  <script>
    import { enhance } from '../../design-system/components/behaviours.mjs';
    enhance(document);
    /* Masthead menu on small screens: the nav is visible without JavaScript; the button only collapses it. */
    const btn = document.querySelector('.mast__menu'), navEl = document.getElementById('mast-nav');
    if (btn && navEl) {
      btn.hidden = false; document.documentElement.classList.add('js-mast');
      btn.addEventListener('click', () => { const open = btn.getAttribute('aria-expanded') !== 'true'; btn.setAttribute('aria-expanded', String(open)); navEl.classList.toggle('is-open', open); });
      document.addEventListener('keydown', e => { if (e.key === 'Escape' && navEl.classList.contains('is-open')) { btn.setAttribute('aria-expanded', 'false'); navEl.classList.remove('is-open'); btn.focus(); } });
    }
  </script>
</body>
</html>
