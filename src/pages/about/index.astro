---
import Base from '../../layouts/Base.astro';
import model from '../../lib/content.mjs';
const crumbs = [{ label: 'Home', href: '/' }, { label: 'About' }];
const chip = (k, t) => `<span class="hwp-chip hwp-chip--${k}">${t}</span>`;
const labels = [
  [chip('verified', 'Official rule verified · 19 October 2026'), 'An official competition fact checked against England Football, with the date and a link to the source. Rechecked each season.'],
  [chip('reviewed', '✓ Coaching reviewed · date'), 'A qualified coach has reviewed this guidance. Their name and the date are recorded.'],
  [chip('review', 'Coaching review required'), 'Written, waiting for a qualified reviewer. Only visible in private previews.'],
  [chip('draft', 'Draft'), 'Work in progress. Only visible in private previews.'],
  [chip('exploratory', 'Exploratory'), 'An experimental coaching idea. Always shown with a yellow strip and dashed frame, and needs a separate public approval.'],
  [chip('soon', 'Coming soon'), 'Planned. Nothing to read yet.']
];
---
<Base title="About How We Play and our editorial standards" description="Who writes How We Play, how coaching guidance is reviewed before it's published, what our labels mean, and our rules for ourselves. Independent; not affiliated with The FA." ids={['about']} nav="about" crumbs={crumbs}>
  <div class="guide-head">
    <div class="flow">
      <p class="hwp-label over">About</p>
      <h1 class="hwp-heading-l">About and standards</h1>
      <p class="hwp-standfirst">How We Play is a free, visual football coaching resource for grassroots coaches.</p>
      <p class="lede">We explain formations, playing principles and individual responsibilities through straightforward language and clear tactical illustrations. {model.site.philosophy}</p>
    </div>
    <p class="hwp-small hwp-secondary measure" style="margin:0">{model.site.independence} Official rules link to their source with the date we checked them.</p>
  </div>

  <section class="section" aria-labelledby="h-origin">
    <div class="hwp-section-divider hwp-rule-section"><span class="hwp-label">Where it comes from</span></div>
    <div class="two-col">
      <h2 class="hwp-heading-m" id="h-origin">A playbook made for one team</h2>
      <div class="prose lede"><p>The pictures and words started as a playbook for one grassroots youth team. This site adapts that method for any coach. It's one approach, not the only approach.</p><p>Permission to adapt and publish that original playbook is being agreed before anything based on it goes public.</p></div>
    </div>
  </section>

  <section class="section" aria-labelledby="h-people">
    <div class="hwp-section-divider hwp-rule-section"><span class="hwp-label">Who writes and who checks</span></div>
    <h2 class="hwp-heading-m" id="h-people">Who writes and who checks</h2>
    <div class="table-scroll" role="region" aria-label="Table: who writes and who checks" tabindex="0">
      <table><thead><tr><th scope="col">Role</th><th scope="col">Who</th><th scope="col">Status</th></tr></thead>
      <tbody>
        <tr><th scope="row">Author and editor</th><td>A volunteer grassroots youth coach</td><td>Name to be confirmed for launch</td></tr>
        <tr><th scope="row">Qualified coaching reviewer</th><td>Not yet appointed</td><td>No coaching guidance is published until reviewed</td></tr>
        <tr><th scope="row">Official rule check</th><td>The editor, against England Football's published guidance</td><td>Checked 19 October 2026 for 2026/27</td></tr>
      </tbody></table>
    </div>
  </section>

  <section class="section" aria-labelledby="h-labels">
    <div class="hwp-section-divider hwp-rule-section"><span class="hwp-label">What the labels mean</span></div>
    <h2 class="hwp-heading-m" id="h-labels">Three separate checks</h2>
    <p class="lede">Design, coaching content and official rules are checked separately. One never stands in for another: a verified rule doesn't make a tactic reviewed.</p>
    <dl class="facts" data-hwp-legend aria-label="Status labels">{labels.map(([c, t]) => <div><dt set:html={c} /><dd style="font-weight:400">{t}</dd></div>)}</dl>
  </section>

  <section class="section" aria-labelledby="h-rules">
    <div class="hwp-section-divider hwp-rule-section"><span class="hwp-label">Our rules for ourselves</span></div>
    <h2 class="hwp-heading-m" id="h-rules">Our rules for ourselves</h2>
    <ul class="list lede">
      <li>Coaching guidance is published only after a qualified coach has reviewed it.</li>
      <li>Official rules link to their source and show the date we checked them.</li>
      <li>Tactical illustrations only: no photos of children, no player names, no club badges.</li>
      <li>No invented qualifications, reviews, testimonials or results.</li>
      <li>Every guide is free to read and share, with no sign-up and no payment.</li>
    </ul>
  </section>
</Base>
