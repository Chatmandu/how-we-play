---
/* Homepage: "The issue" (approved 20 Oct 2026). A cover, a contents list, one feature lesson with its
 * live diagram, an index of the other rules, then Moving Up beside the colophon. Everything built from
 * the 3-1-3-1 sits inside a Gated block, so the page still builds safely if that guide is withdrawn. */
import Base from '../layouts/Base.astro';
import Gated from '../components/Gated.astro';
import LessonFigure from '../components/LessonFigure.astro';
import model from '../lib/content.mjs';
import { renderPitch, statusChips, longDate } from '../lib/ui.mjs';
import { recordedReviewers, developmentShelf, pad2, word } from '../lib/editorial.mjs';

const site = model.site;
const f = model.formation('3-1-3-1');
const fBase = `/formations/9v9/${f.slug}/`;
const feature = f.rules.find(r => r.id === 'one-goes-one-stays');
const others = f.rules.filter(r => r.id !== feature.id);
const shape = { ...f.shape };
const shapeSvg = renderPitch(shape, { theme: 'blue', title: shape.title, desc: shape.altSummary });
const thumb = r => { const d = f.diagrams[r.diagram].frames[r.thumb || 0]; return renderPitch(d, { theme: 'blue', numbers: false, labels: false, title: d.caption, desc: d.altSummary || d.caption }); };
const reviewers = recordedReviewers(model);
const shelf = developmentShelf(model);
const fact = id => model.fact(id);
const main = v => String(v).replace(/\s*\(.*\)$/, '').replace(/^Up to /, '');
const stats = [
  ['Recommended pitch', main(fact('pitch').v9), main(fact('pitch').v7)],
  ['Ball', fact('ball').v9, fact('ball').v7],
  ['Match length, up to', main(fact('length').v9), main(fact('length').v7)],
  ['Offside', fact('offside').v9, fact('offside').v7]
];
const checked = [...new Set(['pitch', 'ball', 'length', 'offside'].map(i => fact(i).checkedOn))].map(longDate).join(', ');
const contents = [
  { n: '01', href: fBase, t: `The ${f.name} guide`, s: 'A starting shape, four rules and a job for every position' },
  { n: '02', href: '#feature', t: feature.title, s: 'This issue’s lesson, with the diagram that plays it' },
  { n: '03', href: `${fBase}#positions`, t: `${word(f.roles.length)} positions`.replace(/^./, c => c.toUpperCase()), s: f.roles.slice(0, 4).map(r => r.title).join(', ') + ' and more' },
  { n: '04', href: '/moving-up/', t: 'Moving from 7v7 to 9v9', s: 'What changes, what stays and what to sort out before pre-season' }
];
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: site.url + '/', description: site.description, inLanguage: 'en-GB' },
  { '@context': 'https://schema.org', '@type': 'Organization', name: site.name, url: site.url + '/', logo: site.url + '/hwp/social/hwp-avatar-800.png' }
];
---
<Base title="How We Play: free grassroots football coaching guides" description="Free, visual football coaching guides for grassroots coaches. Formations, playing principles and each player's job, explained simply. Starting with 9v9." ids={['home']} ogType="website" jsonLd={jsonLd} editorial>
  <section class="cover ed-grid" aria-labelledby="cover-h">
    <div class="cover__text">
      <p class="ed-kicker">How We Play · For U12 and U13 coaches</p>
      <h1 id="cover-h">The step <br class="br-d">up <br class="br-m">to <br class="br-d"><span class="num">9v9</span></h1>
      <p class="cover__deck">Two more players, a much bigger pitch and offside for the first time. <em>Free, visual guides that help volunteer coaches get their team ready.</em></p>
      <div class="cover__cta">
        <Gated ids={[f.registerId]} strip={false}><a class="ed-btn" href={fBase}>Open the {f.name} guide →</a><a slot="fallback" class="ed-btn" href="/formations/9v9/">See the 9v9 formations →</a></Gated>
        <a class="ed-go" href="/moving-up/">What changes from 7v7</a>
      </div>
    </div>
    <Gated ids={[f.registerId]} strip={false}>
      <figure class="plate on-pitch">
        <div class="plate__head"><span>Fig. 1 · Starting shape</span><span>9v9 · {f.notation}</span></div>
        <div class="plate__stage" set:html={shapeSvg} />
        <figcaption>{f.shapeCue}</figcaption>
      </figure>
    </Gated>
    <nav class="contents" aria-labelledby="contents-h">
      <h2 id="contents-h">In this issue</h2>
      <ol>{contents.map(c => <li><a href={c.href}><b aria-hidden="true">{c.n}</b><strong>{c.t}</strong><span>{c.s}</span></a></li>)}</ol>
    </nav>
  </section>

  <Gated ids={[f.registerId]} strip={false}>
    <section class="feature ed-grid" id="feature" aria-labelledby="feature-h">
      <div class="feature__rail" aria-hidden="true"><span class="feature__num">{pad2(feature.n)}</span><p>Rule {word(feature.n)} of {word(f.rules.length)}<br>{f.name}</p></div>
      <div class="feature__head" data-num={pad2(feature.n)}>
        <p class="ed-kicker feature__kicker">Rule {word(feature.n)} of {word(f.rules.length)} · {f.name}</p>
        <h2 class="feature__title" id="feature-h">{feature.title}</h2>
        <p class="ed-stand">{feature.tag} {feature.summary}</p>
      </div>
      <div class="feature__body">
        <LessonFigure id="home-lesson" frames={f.diagrams[feature.diagram].frames} figLabel={`Fig. 2 · ${feature.title}`} context={`9v9 · ${f.name}`} source={`Redrawn from the source playbook, ${feature.src}.`}>
          <div class="ed-cue"><p>Say it on the touchline</p><blockquote>{feature.cue}</blockquote>{feature.extra && <p class="ed-small">{feature.extra}</p>}</div>
          <div class="ed-status"><div class="ed-chips" set:html={statusChips(f.register)} /><a class="ed-go" href={`${fBase}${feature.id}/`}>Read the full lesson</a></div>
        </LessonFigure>
      </div>
    </section>

    <section class="index-row ed-grid" aria-labelledby="others-h" style={`--n:${others.length}`}>
      <h2 id="others-h">The other {word(others.length)} rules</h2>
      <ul>{others.map(r => <li><a href={`${fBase}${r.id}/`}><span class="thumb" aria-hidden="true" set:html={thumb(r)} /><span><b>Rule {r.n}</b><strong>{r.title}</strong><i>{r.cue}</i></span></a></li>)}</ul>
    </section>
  </Gated>

  <section class="lower ed-grid">
    <div class="lower__main">
      <p class="ed-kicker">Moving up · 7v7 to 9v9</p>
      <h2 class="ed-h2">What changes at nine a side</h2>
      <p class="ed-lede">A lot stays the same, and that's the place to start. These are England Football's maximum formats for {fact('pitch').season}; check your league for local rules.</p>
      <dl class="stats">{stats.map(([k, now, was]) => <div><dt>{k}</dt><dd>{now}</dd><small>7v7: {was}</small></div>)}</dl>
      <div class="lower__foot"><span class="hwp-chip hwp-chip--verified">Official rule verified · {checked}</span><a class="ed-go" href="/moving-up/">Read Moving Up</a></div>
    </div>
    <aside class="colophon" aria-label="How we work">
      <p class="motto"><span>Simple pictures.</span><span>Simple decisions.</span><span>Play together.</span></p>
      <div><h2>Who's behind it</h2><p class="ed-small">Written by Niall Walsh, a volunteer grassroots coach.{reviewers.length > 0 && ` Coaching content is reviewed by ${reviewers.join(' and ')} before it's published.`} Independent: not affiliated with or endorsed by The FA. <a href="/about/">Our standards</a></p></div>
      <div><h2>In development</h2><ul class="devlist">{shelf.map(x => <li>{x.name} <em>{x.status}</em></li>)}</ul></div>
    </aside>
  </section>
</Base>
