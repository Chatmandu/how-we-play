---
/* Homepage: How We Play is the publication. A short introduction, the formats, the featured issue, then the
 * latest published additions from content/editorial/feed.json. Nothing here is fixed to a particular lesson. */
import Base from '../layouts/Base.astro';
import model from '../lib/content.mjs';
import { renderPitch, statusChips, longDate } from '../lib/ui.mjs';
import { pad2, word, issueLabel } from '../lib/editorial.mjs';
import { latest, featured } from '../lib/feed.mjs';

const site = model.site;
const f = model.formation(featured().formation);
const live = f && f.gate.allowed && f.register.content.status === 'reviewed';
const fBase = `/formations/9v9/${f.slug}/`;
const ch = id => f.issue.chapters.find(c => c.id === id);
const rule = id => f.rules.find(r => r.id === id);
const shapeSvg = live ? renderPitch(f.shape, { theme: 'blue', title: f.shape.title, desc: f.shape.altSummary }) : '';
const nineIssues = model.formations.filter(x => x.issue);
const pubCount = nineIssues.filter(x => x.register.content.status === 'reviewed' && x.gate.allowed).length;
const formats = ['5v5', '7v7', '9v9'].map(id => {
  const fm = site.formats.find(x => x.id === id);
  if (fm.availability !== 'live') return { id, ages: fm.ages, href: `/formations/${id}/`, state: 'In development', note: 'No guides published yet' };
  return { id, ages: fm.ages, href: `/formations/${id}/`, state: pubCount ? `${word(pubCount).replace(/^./, c => c.toUpperCase())} issue published` : 'First issue in review', note: `${word(nineIssues.length - pubCount).replace(/^./, c => c.toUpperCase())} more in development`, live: true };
});
const items = latest(model);
const illo = i => {
  if (i.illustration?.kind === 'rule-thumb' && i.formationData) {
    const r = i.formationData.rules.find(x => x.id === i.illustration.rule);
    const d = i.formationData.diagrams[r.diagram].frames[r.thumb || 0];
    return { svg: renderPitch(d, { theme: 'blue', numbers: false, labels: false, title: d.caption, desc: d.altSummary || d.caption }) };
  }
  return { text: i.illustration?.text || i.format };
};
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: site.url + '/', description: site.description, inLanguage: 'en-GB' },
  { '@context': 'https://schema.org', '@type': 'Organization', name: site.name, url: site.url + '/', logo: site.url + '/hwp/social/hwp-avatar-800.png', founder: { '@type': 'Person', name: site.author.name, url: site.url + site.author.url }, sameAs: Object.values(site.social).map(s => s.url) }
];
---
<Base title="How We Play: free grassroots football coaching guides" description="Free football formation guides, tactical diagrams and practical advice for grassroots coaches, for 5v5, 7v7 and 9v9 football." ids={['home']} ogType="website" jsonLd={jsonLd} editorial>
  <section class="intro ed-grid" aria-labelledby="cover-h">
    <div class="intro__text">
      <p class="ed-kicker">A grassroots football coaching publication</p>
      <h1 id="cover-h">Helping your team take the <span class="num">next step.</span></h1>
      <p class="cover__deck">Free visual formation guides and practical tactical explanations for 5v5, 7v7 and 9v9 football. <a href="/about/">Written by a grassroots coach</a>.</p>
    </div>
    <nav class="formats" aria-labelledby="formats-h">
      <h2 id="formats-h">Choose your format</h2>
      <ol>{formats.map(x => <li><a href={x.href} class={x.live ? 'is-live' : undefined}><b>{x.id}</b><span class="formats__ages">{x.ages}</span><span class="formats__state">{x.state}</span><span class="formats__note">{x.note}</span></a></li>)}</ol>
    </nav>
  </section>

  {live && (
    <section class="featured ed-grid" aria-labelledby="issue-h">
      <figure class="plate featured__plate on-pitch">
        <div class="plate__head"><span>9v9 · {issueLabel(f)}</span><span>Starting shape</span></div>
        <div class="plate__stage" set:html={shapeSvg} />
        <figcaption>{f.shapeCue}</figcaption>
      </figure>
      <div class="featured__text">
        <p class="ed-kicker">Featured issue · 9v9 · {issueLabel(f)}</p>
        <h2 class="issue-feature__title" id="issue-h"><span class="issue-feature__no" aria-hidden="true">{pad2(f.issue.number)}</span>The {f.name}</h2>
        <p class="ed-stand">{f.issue.intro}</p>
        <ol class="featured__chapters">
          {f.issue.chapters.map(c => <li><b>Chapter {c.n}</b> {c.title}{c.rules ? <span>: {c.rules.map(id => rule(id).title).join(', ')}</span> : ''}</li>)}
        </ol>
        <div class="issue-feature__cta"><a class="ed-btn" href={fBase}>Read {issueLabel(f)}: the {f.name} →</a><div class="ed-chips" set:html={statusChips(f.register)} /></div>
      </div>
    </section>
  )}

  {items.length > 0 && (
    <section class="latest ed-grid" aria-labelledby="latest-h">
      <div class="ed-sh"><h2 class="ed-label" id="latest-h">Latest additions</h2><a class="ed-small" href="/about/">About How We Play</a></div>
      <ol class="latest__list">
        {items.map(i => { const il = illo(i); return (
          <li><a href={i.href}>
            <span class={`latest__illo${il.svg ? ' on-pitch' : ''}`} aria-hidden="true">{il.svg ? <Fragment set:html={il.svg} /> : <span>{il.text}</span>}</span>
            <span class="latest__body">
              <span class="latest__meta">{i.typeLabel}{i.formationData ? ` · ${i.format} · ${issueLabel(i.formationData)}` : i.format ? ` · ${i.format}` : ''} · <time datetime={i.published}>{longDate(i.published)}</time></span>
              <strong>{i.title}</strong>
              <span class="latest__ex">{i.excerpt}</span>
            </span>
          </a></li>
        ); })}
      </ol>
    </section>
  )}
</Base>
