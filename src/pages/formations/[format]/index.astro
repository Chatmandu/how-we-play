---
/* Format collections that have no published issue yet (5v5, 7v7). Honest placeholders: in development,
 * noindex, out of the sitemap, with a way back to what is published. 9v9 has its own page. */
import Base from '../../../layouts/Base.astro';
import model from '../../../lib/content.mjs';
import { issueLabel } from '../../../lib/editorial.mjs';

export function getStaticPaths() {
  return model.site.formats.filter(x => ['5v5', '7v7'].includes(x.id) && x.availability !== 'live').map(x => ({ params: { format: x.id }, props: { fm: x } }));
}
const { fm } = Astro.props;
const first = model.formations.find(f => f.register.content.status === 'reviewed' && f.gate.allowed);
const crumbs = [{ label: 'Home', href: '/' }, { label: `${fm.id} formations` }];
---
<Base title={`${fm.id} football formations: in development | How We Play`} description={`How We Play's ${fm.id} collection for ${fm.ages} is in development. Nothing is published yet; see our published guides instead.`} ids={[fm.id]} nav={fm.id} crumbs={crumbs} noindex editorial>
  <div class="page-head ed-grid">
    <div class="page-head__text">
      <p class="ed-kicker">Format · {fm.ages.replace('–', ' and ')}</p>
      <h1>{fm.id}</h1>
      <p class="ed-stand">Our {fm.id} collection is in development. There's nothing published here yet, and we won't put guides up until they've been written and reviewed.</p>
    </div>
    <div class="page-head__aside">
      <p class="ed-label">Published now</p>
      {first && <a class="ed-btn" href={`/formations/9v9/${first.slug}/`}>9v9 · {issueLabel(first)} · The {first.name} →</a>}
      <p class="ed-small"><a href="/moving-up/">Moving up a format</a> · <a href="/about/">About How We Play</a></p>
    </div>
  </div>
</Base>
