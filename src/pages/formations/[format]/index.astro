---
/* 5v5 magazine collection. Only reviewed, published playbooks appear publicly. */
import Base from '../../../layouts/Base.astro';
import TeamSheet from '../../../components/TeamSheet.astro';
import model from '../../../lib/content.mjs';
import { issueLabel } from '../../../lib/editorial.mjs';
import { collectionStructuredData } from '../../../lib/seo.mjs';

export function getStaticPaths() {
  return model.site.formats.filter(x => x.id === '5v5').map(x => ({ params: { format: x.id }, props: { fm: x } }));
}
const { fm } = Astro.props;
const forms = model.formations.filter(f => f.format === '5v5' && f.issue).sort((a, b) => a.issue.number - b.issue.number);
const published = forms.filter(f => f.register.content.status === 'reviewed' && f.gate.allowed && !!f.issue.published);
const preparing = forms.filter(f => !published.includes(f));
const preview = model.target !== 'public';
const firstElsewhere = model.formations.find(f => f.gate.allowed && f.register.content.status === 'reviewed' && f.format !== '5v5');
const crumbs = [{ label: 'Home', href: '/' }, { label: '5v5 formations' }];
const shapeNames = published.map(f => f.name).join(' and ');
const title = published.length ? '5v5 Football Formations & Coaching Guides | How We Play Football' : '5v5 football formations: in development | How We Play Football';
const desc = published.length ? `Free illustrated 5v5 football and youth soccer guides: ${shapeNames} formations, four playing principles and player roles for grassroots coaches.` : 'Our 5v5 football formation guides are in development and awaiting independent coaching review.';
const jsonLd = published.length ? collectionStructuredData(model.site, published, '5v5') : [];
const glance = [
  ['Age groups in England', fm.ages.replace('–', ' and ')],
  ['Players', '5, including a goalkeeper'],
  ['Outfield players', '4'],
  ['Published guides', published.length ? `${published.length}: ${shapeNames}` : 'In preparation']
];
---
<Base title={title} description={desc} ids={['5v5-hub']} nav="5v5" crumbs={crumbs} jsonLd={jsonLd} ogType="website" noindex={!published.length} editorial meta={{ type: 'format', format: '5v5', group: 'Formats' }}>
  <header class="page-head ed-grid">
    <div class="page-head__text">
      <p class="ed-kicker">Format · {fm.ages.replace('–', ' and ')}</p>
      <h1>5v5 formations</h1>
      <p class="ed-stand">Four outfield players and a goalkeeper. Explore the {shapeNames || 'first'} starting shapes, learn how to support the ball and find space, and give every child a chance to try different roles.</p>
      <p class="ed-small usa-format-link">Coaching in the USA? Small-sided formats and goalkeeper rules may differ. <a href="/coaching-in-the-usa/">See our US coaching guide →</a></p>
    </div>
    <div class="page-head__aside">
      <dl class="glance" aria-label="5v5 at a glance">{glance.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
      <p class="ed-small">These guides describe England's goalkeeper-inclusive 5v5. Always check your own competition's rules.</p>
    </div>
  </header>

  {published.map(f => (
    <section class="ed-section" aria-label={`${issueLabel(f)}: the ${f.name}`}>
      <div class="ed-grid"><div class="ed-sh"><p class="ed-label">5v5 · {issueLabel(f)} · Published</p><span class="ed-label" style="color:var(--hwp-text-secondary)">Four principles · {f.roles.length} position groups</span></div></div>
      <TeamSheet f={f} third="rules" />
      <div class="ed-grid" style="margin-top:20px"><p style="grid-column:1/-1"><a class="ed-btn" href={`/formations/5v5/${f.slug}/`}>Explore the {f.name} guide →</a></p></div>
    </section>
  ))}

  {preview && preparing.filter(f => f.gate.allowed).map(f => (
    <section class="ed-section" aria-label={`${issueLabel(f)}: the ${f.name}, private research draft`} data-hwp-reviewer-only>
      <div class="ed-grid"><div class="ed-sh"><p class="ed-label">5v5 · {issueLabel(f)} · Private coaching review</p><span class="ed-label" style="color:var(--hwp-text-secondary)">Unreviewed research draft, not for publication</span></div></div>
      <TeamSheet f={f} third="rules" />
      <div class="ed-grid" style="margin-top:20px"><p style="grid-column:1/-1"><a class="ed-btn" href={`/formations/5v5/${f.slug}/`}>Open private draft: the {f.name} →</a></p></div>
    </section>
  ))}

  {published.length === 0 && (
    <section class="ed-section ed-grid" aria-labelledby="5v5-coming-h">
      <div class="chapter__head"><p class="ed-kicker">In development</p><h2 class="ed-h2" id="5v5-coming-h">The first playbooks are being reviewed</h2></div>
      <div class="chapter__side"><p>We're preparing guides for the 1-2-1 diamond and 2-2 box. They won't appear as published coaching guidance until the diagrams and advice have been reviewed.</p>{firstElsewhere && <a class="ed-btn" href={`/formations/${firstElsewhere.format}/${firstElsewhere.slug}/`}>Explore a published {firstElsewhere.format} guide →</a>}</div>
    </section>
  )}

  {published.length > 0 && preparing.length > 0 && (
    <section class="ed-section ed-grid split" aria-labelledby="5v5-preparing-h">
      <div class="split__main"><p class="ed-kicker">Coming next</p><h2 class="ed-h2" id="5v5-preparing-h">Guides in preparation</h2><p class="ed-small">New guides appear once their coaching review is complete.</p></div>
      <div class="split__side"><ol class="issue-list">{preparing.map(f => <li><div><b>{f.format}</b><span><strong>The {f.name}</strong><em>In preparation</em></span></div></li>)}</ol></div>
    </section>
  )}

  <section class="ed-section ed-grid split" aria-labelledby="5v5-more-h">
    <div class="split__main"><p class="ed-kicker">Moving up</p><h2 class="ed-h2" id="5v5-more-h">What comes next?</h2><p>In 7v7, teams add two outfield players. The ideas of support, width and working together remain useful.</p></div>
    <div class="split__side"><a class="ed-btn" href="/formations/7v7/">Explore 7v7 formations →</a></div>
  </section>
</Base>
