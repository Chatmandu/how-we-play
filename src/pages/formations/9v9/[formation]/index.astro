---
/* Formation issue landing page, e.g. 9v9 · The 3-1-3-1. A cover, a contents list, then four chapters:
 * starting shape, the playing principles, a job for every player, playing together. Then any further features
 * (only when written and reviewed) and the playbook. Draft formations (preview builds only) use the same shell. */
import Base from '../../../../layouts/Base.astro';
import Gated from '../../../../components/Gated.astro';
import FormationCover from '../../../../components/FormationCover.astro';
import Support from '../../../../components/Support.astro';
import CoachingNotes from '../../../../components/CoachingNotes.astro';
import IssueVideo from '../../../../components/IssueVideo.astro';
import model from '../../../../lib/content.mjs';
import { renderPitch, reviewNote, button } from '../../../../lib/ui.mjs';
import { pad2, word, issueLabel, publishedIssues } from '../../../../lib/editorial.mjs';
import { issueStructuredData } from '../../../../lib/seo.mjs';
import { formationSearchTitle, formationSearchDescription } from '../../../../lib/search-copy.mjs';

export function getStaticPaths() {
  return model.formations.filter(f => f.format === '9v9' && f.gate.allowed).map(f => ({ params: { formation: f.slug }, props: { slug: f.slug } }));
}
const f = model.formation(Astro.props.slug);
const exploratory = !!f.register.content.exploratory && !f.register.content.publicApproval;
const base = `/formations/9v9/${f.slug}/`;
const printGuideBase = `/downloads/How-We-Play-Football-9v9-${f.slug}`;
const printGuideAvailable = ['3-3-2', '2-2-3-1'].includes(f.slug);
const full = Array.isArray(f.roles) && f.issue && f.issue.chapters;
const reviewerNotes = model.target !== 'public';
const chap = id => full ? f.issue.chapters.find(c => c.id === id) : null;
const rule = id => f.rules.find(r => r.id === id);
const role = id => f.roles.find(r => r.id === id);
const thumb = r => { const d = f.diagrams[r.diagram].frames[r.thumb || 0]; return renderPitch(d, { theme: 'blue', numbers: false, labels: false, title: d.caption, desc: String(d.altSummary || d.caption).replace(/^Provisional\s+/i, '') }); };
const shape = { ...f.shape, title: f.shape.title || `${f.name} starting shape`, altSummary: f.shape.altSummary || f.shape.alt };
const shapeSvg = renderPitch(shape, { theme: 'blue', title: shape.title, desc: shape.altSummary });
// Public guides expose the same approved starting picture as a crawlable image file.
const shapeImage = model.target === 'public' && full ? `/diagrams/formations/${f.format}-${f.slug}-starting-shape.svg` : null;
const label = issueLabel(f);
const otherIssues = publishedIssues(model).filter(other => other.format === f.format && other.slug !== f.slug);
// Film releases are editorial additions and do not change reviewed coaching data.
// Match each full-length explainer to its approved formation guide.
const explainers = {
  '3-1-3-1': { youtubeId: 'KEKPal0Upd4', label: '9v9 · 3-1-3-1 · Full video explainer' },
  '3-2-3': { youtubeId: 'tWzAKTaX2sI', label: '9v9 · 3-2-3 · Full video explainer' }
};
const explainer = full ? explainers[f.slug] ?? null : null;
const shapeAttribution = f.shape.sourcePage
  ? `Redrawn from the source playbook, ${f.shape.sourcePage}.`
  : f.register.content.status === 'reviewed'
    ? 'Illustrated by How We Play Football from reviewed coaching guidance.'
    : 'Provisional illustration for coaching review; not published coaching advice.';
const crumbs = [{ label: 'Home', href: '/' }, { label: '9v9 formations', href: '/formations/9v9/' }, { label: `${label}: ${f.name}` }];
const title = full ? formationSearchTitle(f) : `${f.name} draft formation guide for 9v9 | How We Play Football`;
const description = full
  ? formationSearchDescription(f)
  : `${f.sourceLabel} of a ${f.notation} guide for 9v9. Private preview, not reviewed.`;
const jsonLd = issueStructuredData(model.site, f);
const contents = full ? [
  ...(explainer ? [{ href: '#watch', n: 'Watch', t: 'The full formation explainer' }] : []),
  ...f.issue.chapters.map(c => ({ href: `#${c.id}`, n: `Chapter ${c.n}`, t: c.title })), 
  ...(f.issue.features && f.issue.features.length ? [{ href: '#features', n: 'Features', t: 'More from this issue' }] : []),
  { href: '#playbook', n: 'Playbook', t: 'The printable edition' }
] : [];
---
<Base title={title} description={description} ids={['9v9-hub', f.registerId]} nav="9v9" crumbs={crumbs} jsonLd={jsonLd} editorial meta={{ type: 'formation_issue', format: f.format, issue: f.issue && f.issue.number, formation: f.slug, group: 'Formation issues' }}>
  <Gated ids={[f.registerId]}>
    <FormationCover f={f} contents={contents} full={full} exploratory={exploratory} explainer={explainer}>
      <p slot="usa" class="ed-small usa-issue-link">Coaching 9v9 soccer in the USA? The {f.name} is one starting shape for teams, generally U11–U12. <a href="/coaching-in-the-usa/">Check US age groups and formats →</a></p>
    </FormationCover>

    {full ? (
      <>
        {explainer && <IssueVideo youtubeId={explainer.youtubeId} formation={f.name} shape={f.shape} label={explainer.label} principles={f.rules.map(r => r.title)} />}
        <section class="ed-section chapter ed-grid" id="shape" aria-labelledby="c1-h">
          <div class="chapter__head"><p class="chapter__n">Chapter 1</p><h2 class="chapter__t" id="c1-h">{chap('shape').title}</h2><p class="ed-small">{chap('shape').dek}</p></div>
          <figure class="sheet__pitch on-pitch chapter__fig">
            {shapeImage
              ? <img class="formation-shape__image" src={shapeImage.replace(/\.svg$/, '.webp')} alt={`${f.format} ${f.name} formation starting shape. ${shape.altSummary}`} loading="lazy" decoding="async" />
              : <Fragment set:html={shapeSvg} />}
            <figcaption>{f.shapeCue} {shapeAttribution} {shapeImage && <a href={shapeImage} download>Download the starting-shape diagram (SVG) →</a>}</figcaption>
          </figure>
          <div class="chapter__side">
            <h3 class="ed-label">This shape gives us</h3>
            <ul class="gives">{f.gives.map(g => <li>{g}</li>)}</ul>
            <p class="ed-small sheet__note"><strong>Our spine</strong> runs through the middle: {String(f.spineText).trim().replace(/[.!?]+$/, '')}.</p>
            <dl class="glance" style="margin-top:20px" aria-label="Notation">{f.structure.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
          </div>
        </section>

        <section class="ed-section chapter ed-grid" id="principles" aria-labelledby="c2-h">
          <div class="chapter__head chapter__head--wide"><p class="chapter__n">Chapter 2</p><h2 class="chapter__t" id="c2-h">{chap('principles').title}</h2><p class="ed-small">{chap('principles').dek}</p></div>
          <ol class="rules4">
            {chap('principles').rules.map(id => rule(id)).map(r => (
              <li><a href={`${base}${r.id}/`}>
                <span class="thumb" aria-hidden="true" set:html={thumb(r)} />
                <span><span class="n" aria-hidden="true">{pad2(r.n)}</span><strong>{r.title}</strong><p>{r.summary}</p><span class="cueline" style="display:block">“{r.cue}”</span></span>
              </a></li>
            ))}
          </ol>
        </section>

        <CoachingNotes placement="guide" />

        <section class="ed-section chapter ed-grid" id="jobs" aria-labelledby="c3-h">
          <div class="chapter__head"><p class="chapter__n">Chapter 3</p><h2 class="chapter__t" id="c3-h">{chap('jobs').title}</h2><p class="ed-small">{chap('jobs').dek}</p></div>
          <ol class="roster chapter__list">
            {chap('jobs').roles.map(id => role(id)).map(r => <li><a href={`${base}positions/${r.id}/`}><span class="nums">{r.nums.join(' · ')}</span><span><strong>{r.title}</strong><span>{r.head} <i>Ask yourself: {r.cue}</i></span></span><span class="arr" aria-hidden="true">→</span></a></li>)}
          </ol>
        </section>

        <section class="ed-section chapter ed-grid" id="together" aria-labelledby="c4-h">
          <div class="chapter__head"><p class="chapter__n">Chapter 4</p><h2 class="chapter__t" id="c4-h">{chap('together').title}</h2><p class="ed-small">{chap('together').dek}</p></div>
          <div class="together together--quick">
            <p class="together__intro">A quick reminder for the touchline. Choose a principle or partnership to explore the full coaching detail.</p>
            {chap('together').groups.map(g => (
              <div class="together__group">
                <h3 class="ed-label">{g.title}</h3>
                <ul class="together__links">{g.items.map(it => it.rule
                  ? (r => <li><a href={`${base}${r.id}/`}><span class="together__type">Principle {r.n}</span><strong>{r.title}</strong><span class="together__arrow" aria-hidden="true">→</span></a></li>)(rule(it.rule))
                  : (r => <li><a href={`${base}positions/${r.id}/`}><span class="together__type">Partnership · {r.nums.join(' and ')}</span><strong>{r.title}</strong><span class="together__arrow" aria-hidden="true">→</span></a></li>)(role(it.role)))}
                </ul>
              </div>
            ))}
          </div>
        </section>

        {f.issue.features && f.issue.features.length > 0 && (
          <section class="ed-section chapter ed-grid" id="features" aria-labelledby="f-h">
            <div class="chapter__head"><p class="chapter__n">Features</p><h2 class="chapter__t" id="f-h">More from this issue</h2></div>
          </section>
        )}

        <section class="ed-section chapter ed-grid" id="playbook" aria-labelledby="pb-h">
          <div class="chapter__head"><p class="chapter__n">The playbook</p><h2 class="chapter__t" id="pb-h">Printable {f.name} playbook</h2></div>
          <div class="chapter__side ed-download">
            {f.slug === '3-1-3-1' ? (
              <>
                <p class="ed-lede">Take the formation guide to training or matchday. Both downloads are free, with no email or payment required.</p>
                <div class="ed-download__links" aria-label="Choose a printable guide">
                  <a class="ed-btn" href="/downloads/How-We-Play-Football-3-1-3-1-A4.pdf" download>Download A4 guide (PDF) <span aria-hidden="true">↓</span></a>
                  <a class="ed-btn" href="/downloads/How-We-Play-Football-3-1-3-1-A5.pdf" download>Download compact booklet (PDF) <span aria-hidden="true">↓</span></a>
                </div>
                <p class="ed-small">A4: 24-page guide (2.9 MB). Compact booklet: 20 pages arranged as ten two-page spreads (1.9 MB). The compact file uses US Letter landscape sheets, not individual A5 pages.</p>
              </>
            ) : printGuideAvailable ? (
              <>
                <p class="ed-lede">Download the full formation guide for free, to use at training or share with players and parents. No email or payment required.</p>
                <div class="ed-download__links" aria-label="Choose a printable guide">
                  <a class="ed-btn" href={`${printGuideBase}-A4-Coach-Guide.pdf`} download>Download A4 coach's guide (PDF) <span aria-hidden="true">↓</span></a>
                  <a class="ed-btn" href={`${printGuideBase}-A5-Pitchside-Booklet.pdf`} download>Download A5 pitchside booklet (PDF) <span aria-hidden="true">↓</span></a>
                  <a class="ed-btn" href={`${printGuideBase}-A5-Booklet-A4-Print-Sheets.pdf`} download>Print your own A5 booklet (PDF) <span aria-hidden="true">↓</span></a>
                </div>
                <p class="ed-small">The A4 guide is for reading or home printing. The A5 booklet is in reading order for phones and tablets. To make a folded A5 booklet at home, download the print sheets and print double-sided on A4 landscape paper, flipping on the short edge at 100% size, then fold and staple.</p>
              </>
            ) : (
              <p class="ed-lede">The printable guide isn't released yet.</p>
            )}
            <p class="ed-small" style="color:var(--hwp-text-secondary)">More features for this formation, such as restarts and matchday guidance, will be added only once they've been written and reviewed.</p>
          </div>
        </section>

        {f.register.content.status === 'reviewed' && <Support />}

        {otherIssues.length > 0 && (
          <nav class="ed-section ed-grid split" aria-labelledby="other-issues-h">
            <div class="split__main">
              <p class="ed-kicker">Keep exploring</p>
              <h2 class="ed-h2" id="other-issues-h">Other 9v9 formation guides</h2>
              <p class="ed-small">Different shapes ask different things of your players. Explore another complete issue, or <a href="/formations/9v9/">return to all 9v9 formations</a>.</p>
            </div>
            <div class="split__side">
              <ol class="issue-list">
                {otherIssues.map(other => <li><a href={`/formations/9v9/${other.slug}/`}><b>{other.format}</b><span><strong>The {other.name}</strong><em>{other.issue.summary}</em></span></a></li>)}
              </ol>
            </div>
          </nav>
        )}

        {reviewerNotes && (
          <section class="ed-section ed-grid" id="review" aria-labelledby="h-review" data-hwp-reviewer-only>
            <div style="grid-column:1/-1" class="flow">
              <div class="ed-sh"><h2 class="ed-label" id="h-review">Still being written (reviewer only)</h2></div>
              <Fragment set:html={reviewNote('Needs a qualified coach.', "The source playbook doesn't cover these. We've listed the questions rather than guess the answers.")} />
              <div class="placeholders">{f.review.map(r => <div class="placeholder" id={`review-${r.id}`}><h3>{r.title}</h3><p class="hwp-small" style="margin:0">{r.why}</p><p class="hwp-label">Questions for the reviewer</p><ul>{r.qs.map(q => <li>{q}</li>)}</ul></div>)}</div>
            </div>
          </section>
        )}
      </>
    ) : (
      <>
        <section class="ed-section chapter ed-grid" id="shape" aria-labelledby="c1-h">
          <div class="chapter__head"><p class="chapter__n">Draft</p><h2 class="chapter__t" id="c1-h">Starting shape</h2><p class="ed-small">{f.playerFacing}</p></div>
          <figure class="sheet__pitch on-pitch chapter__fig"><Fragment set:html={shapeSvg} /><figcaption>{f.sourceLabel}. Positions are illustrative.</figcaption></figure>
          <div class="chapter__side">
            <h3 class="ed-label">Four rules (draft)</h3>
            <ol class="rulelist">{f.ruleTable.map(r => <li>{r.lesson ? <a href={`${base}${r.lesson}/`}><b>Rule {r.n}</b><strong>{r.title}</strong><i>{r.say}</i></a> : <div class="row"><b>Rule {r.n}</b><strong>{r.title}</strong><i>{r.say} Diagram not drawn yet.</i></div>}</li>)}</ol>
          </div>
        </section>
        <section class="ed-section chapter ed-grid" aria-labelledby="c3-h">
          <div class="chapter__head"><p class="chapter__n">Draft</p><h2 class="chapter__t" id="c3-h">Positions</h2></div>
          <ol class="roster chapter__list">{f.roleSummary.map(r => <li><div class="row"><span class="nums">{r.nums.join(' · ')}</span><span><strong>{r.title}</strong><span>{r.head}. Ask yourself: {r.ask}</span></span><span></span></div></li>)}</ol>
        </section>
        {reviewerNotes && (
          <section class="ed-section ed-grid" data-hwp-reviewer-only aria-labelledby="h-cons">
            <div style="grid-column:1/-1" class="flow">
              <div class="ed-sh"><h2 class="ed-label" id="h-cons">Reviewer questions (preview only)</h2></div>
              <div class="two-col">
                <div class="flow"><h3 class="hwp-heading-m">May offer</h3><ul class="list">{f.considerations.strengths.map(s => <li>{s}</li>)}</ul></div>
                <div class="flow"><h3 class="hwp-heading-m">May cost</h3><ul class="list">{f.considerations.tradeoffs.map(s => <li>{s}</li>)}</ul></div>
              </div>
              <ol class="list measure">{f.reviewQuestions.map(q => <li>{q}</li>)}</ol>
              <p class="source-line">Source: {f.status.source}. {f.notDrawn}</p>
            </div>
          </section>
        )}
      </>
    )}
    <div slot="fallback"></div>
  </Gated>
</Base>
