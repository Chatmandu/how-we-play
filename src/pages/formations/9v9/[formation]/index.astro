---
/* Formation guide. A page head with the formation name, then the team sheet (shape, positions, what the
 * shape gives us), the four rules as an index with their real diagrams, and the playbook note.
 * One template for every formation; draft formations only exist in preview builds (the gate decides). */
import Base from '../../../../layouts/Base.astro';
import Gated from '../../../../components/Gated.astro';
import TeamSheet from '../../../../components/TeamSheet.astro';
import Byline from '../../../../components/Byline.astro';
import model from '../../../../lib/content.mjs';
import { statusChips, renderPitch, reviewNote, exploratoryStrip, button } from '../../../../lib/ui.mjs';
import { pad2, word } from '../../../../lib/editorial.mjs';

export function getStaticPaths() {
  return model.formations.filter(f => f.gate.allowed).map(f => ({ params: { formation: f.slug }, props: { slug: f.slug } }));
}
const f = model.formation(Astro.props.slug);
const exploratory = !!f.register.content.exploratory;
const visible = model.target === 'public' ? model.publicFormations : model.formations;
const base = `/formations/9v9/${f.slug}/`;
const full = Array.isArray(f.roles);
const reviewerNotes = model.target !== 'public';
const thumb = r => { const d = f.diagrams[r.diagram].frames[r.thumb || 0]; return renderPitch(d, { theme: 'blue', numbers: false, labels: false, title: d.caption, desc: d.altSummary || d.caption }); };
const crumbs = [{ label: 'Home', href: '/' }, { label: '9v9 formations', href: '/formations/9v9/' }, { label: f.name }];
const title = `${f.name} 9v9 formation guide (${f.notation}) | How We Play`;
const description = full
  ? `One possible way to play 9v9: the ${f.notation} starting shape, four simple rules with diagrams and a job for every position. Free guide for grassroots coaches.`
  : `${f.sourceLabel} of a ${f.notation} guide for 9v9. Private preview, not reviewed.`;
const jsonLd = [{ '@context': 'https://schema.org', '@type': 'Article', headline: `${f.name}: 9v9 formation guide`, inLanguage: 'en-GB', author: { '@type': 'Person', name: model.site.author.name, url: model.site.url + '/about/' }, publisher: { '@type': 'Organization', name: 'How We Play' }, isAccessibleForFree: true, about: '9v9 youth football formation' }];
---
<Base title={title} description={description} ids={['9v9-hub', f.registerId]} nav="9v9" crumbs={crumbs} jsonLd={jsonLd} editorial>
  <Gated ids={[f.registerId]}>
    <div class="page-head ed-grid">
      <div class="page-head__text">
        <p class="ed-kicker">9v9 · Formation guide · {f.notation}</p>
        <h1>{f.name}</h1>
        <p class="ed-stand">{full ? 'One possible way to play 9v9: a starting shape, four rules and a job for every position.' : f.idea}</p>
      </div>
      <div class="page-head__aside">
        <div class="ed-chips" set:html={statusChips(f.register)} />
        <Byline f={f} />
        {exploratory && <Fragment set:html={exploratoryStrip()} />}
        <p class="ed-small" style="color:var(--hwp-text-secondary)">{full ? `Redrawn from the source playbook. The formation is a starting picture, not where players have to stand.` : `${f.sourceLabel}. Positions in the diagrams are illustrative.`}</p>
        {visible.length > 1 && <p class="ed-small">Other 9v9 guides: {visible.filter(x => x.slug !== f.slug).map((x, i) => <>{i > 0 && ', '}<a href={`/formations/9v9/${x.slug}/`}>{x.name}</a></>)}</p>}
      </div>
    </div>

    <div id="positions" class="ed-section" style="padding-top:var(--ed-s3)">
      <TeamSheet f={f} third={full ? 'gives' : 'rules'} showHead={false} />
    </div>

    <section class="ed-section ed-section--tight" id="rules" aria-labelledby="h-rules">
      <div class="ed-grid">
        <div class="ed-sh"><h2 class="ed-label" id="h-rules">{full ? `${word(f.rules.length)} rules`.replace(/^./, c => c.toUpperCase()) : 'Four rules (draft)'}</h2><span class="ed-label" style="color:var(--hwp-text-secondary)">Each with its diagram and a touchline cue</span></div>
        {full ? (
          <ol class="rules4">
            {f.rules.map(r => (
              <li><a href={`${base}${r.id}/`}>
                <span class="thumb" aria-hidden="true" set:html={thumb(r)} />
                <span><span class="n" aria-hidden="true">{pad2(r.n)}</span><strong>{r.title}</strong><p>{r.summary}</p><span class="cueline" style="display:block">“{r.cue}”</span></span>
              </a></li>
            ))}
          </ol>
        ) : (
          <ol class="rules4">
            {f.ruleTable.map(r => {
              const inner = <span><span class="n" aria-hidden="true">{pad2(r.n)}</span><strong>{r.title}</strong><p>{r.say} Question: {r.question}</p>{!r.lesson && <p>Diagram not drawn yet.</p>}</span>;
              return <li>{r.lesson ? <a href={`${base}${r.lesson}/`} style="grid-template-columns:1fr">{inner}</a> : <div style="padding:16px 0 28px">{inner}</div>}</li>;
            })}
          </ol>
        )}
      </div>
    </section>

    {full && (
      <section class="ed-section" id="playbook" aria-labelledby="h-pdf">
        <div class="ed-grid split">
          <div class="split__main ed-download">
            <p class="ed-kicker">Free download · no email, no payment</p>
            <h2 class="ed-h2" id="h-pdf">The {f.name} playbook</h2>
            <p class="ed-lede">An A4 version to share with players and parents, built from the same content as these pages. It isn't released yet.</p>
            <Fragment set:html={button({ label: 'PDF not yet released', variant: 'secondary', iconName: 'download', attrs: 'aria-disabled="true" disabled' })} />
          </div>
          <div class="split__side"><p class="ed-small">New to 9v9? <a href="/moving-up/">What changes from 7v7</a>, from pitch size to offside.</p></div>
        </div>
      </section>
    )}

    {reviewerNotes && (
      <section class="ed-section" id="review" aria-labelledby="h-review" data-hwp-reviewer-only>
        <div class="ed-grid"><div style="grid-column:1/-1" class="flow">
          <div class="ed-sh"><h2 class="ed-label" id="h-review">{full ? 'Still being written (reviewer only)' : 'Reviewer questions (preview only)'}</h2></div>
          {full ? (
            <>
              <Fragment set:html={reviewNote('Needs a qualified coach.', "The source playbook doesn't cover these. We've listed the questions rather than guess the answers.")} />
              <div class="placeholders">{f.review.map(r => <div class="placeholder" id={`review-${r.id}`}><h3>{r.title}</h3><p class="hwp-small" style="margin:0">{r.why}</p><p class="hwp-label">Questions for the reviewer</p><ul>{r.qs.map(q => <li>{q}</li>)}</ul></div>)}</div>
            </>
          ) : (
            <>
              <div class="two-col">
                <div class="flow"><h3 class="hwp-heading-m">May offer</h3><ul class="list">{f.considerations.strengths.map(s => <li>{s}</li>)}</ul></div>
                <div class="flow"><h3 class="hwp-heading-m">May cost</h3><ul class="list">{f.considerations.tradeoffs.map(s => <li>{s}</li>)}</ul></div>
              </div>
              <ol class="list measure">{f.reviewQuestions.map(q => <li>{q}</li>)}</ol>
              <p class="source-line">Source: {f.status.source}. {f.notDrawn}</p>
            </>
          )}
        </div></div>
      </section>
    )}
    <div slot="fallback"></div>
  </Gated>
</Base>
