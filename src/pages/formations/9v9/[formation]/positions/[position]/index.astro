---
/* Position page in the editorial layout: the shirt numbers as the folio, the role as the headline, the
 * position's own diagram stepped beside its "ask yourself" cue, then the jobs, the situations and the
 * rules this position uses. Content is exactly the formation file's; nothing is added. */
import Base from '../../../../../../layouts/Base.astro';
import LessonFigure from '../../../../../../components/LessonFigure.astro';
import EdGuideNav from '../../../../../../components/EdGuideNav.astro';
import Byline from '../../../../../../components/Byline.astro';
import model from '../../../../../../lib/content.mjs';
import { statusChips, reviewNote, exploratoryStrip } from '../../../../../../lib/ui.mjs';
import { word, issueLabel, chapterOf } from '../../../../../../lib/editorial.mjs';
import { positionStructuredData } from '../../../../../../lib/seo.mjs';

export function getStaticPaths() {
  return model.formations.filter(f => f.format === '9v9' && f.gate.allowed && Array.isArray(f.roles)).flatMap(f =>
    f.roles.map(r => ({ params: { formation: f.slug, position: r.id }, props: { slug: f.slug, roleId: r.id } })));
}
const f = model.formation(Astro.props.slug);
const i = f.roles.findIndex(r => r.id === Astro.props.roleId);
const r = f.roles[i];
const exploratory = !!f.register.content.exploratory && !f.register.content.publicApproval;
const set = f.diagrams[r.diagram];
const base = `/formations/9v9/${f.slug}/`;
const related = (r.rules || []).map(id => f.rules.find(x => x.id === id)).filter(Boolean);
const reviewerNotes = model.target !== 'public';
const reviews = reviewerNotes ? (r.reviewRefs || []).map(id => f.review.find(x => x.id === id)).filter(Boolean) : [];
const prev = f.roles[i - 1], next = f.roles[i + 1];
const last = f.rules[f.rules.length - 1];
const crumbs = [{ label: 'Home', href: '/' }, { label: '9v9 formations', href: '/formations/9v9/' }, { label: f.name, href: base }, { label: r.title }];
const title = `${r.title}: ${f.name} 9v9 roles | How We Play Football`;
const description = `${r.head} What the ${r.title.toLowerCase()} does in a 9v9 ${f.notation}, with diagrams and one question for players to ask themselves.`;
const folio = r.nums.join('·');
const roleSource = f.shape.sourcePage
  ? `Redrawn from the source playbook, ${r.src}. Shirt numbers describe the starting picture.`
  : f.register.content.status === 'reviewed'
    ? 'How We Play Football illustration based on reviewed guidance. Starting positions are not fixed.'
    : `How We Play draft, ${r.src}. Illustration awaiting qualified coaching review.`;
const chapter = chapterOf(f, { role: r.id });
const jobs = chapter && chapter.roles ? chapter.roles : null;
const where = chapter ? (jobs ? `Chapter ${chapter.n} · Position ${word(jobs.indexOf(r.id) + 1)} of ${word(jobs.length)}` : `Chapter ${chapter.n} · ${chapter.title}`) : `Position ${word(i + 1)} of ${word(f.roles.length)}`;
const jsonLd = positionStructuredData(model.site, f, r);
const pPrev = prev ? { href: `${base}positions/${prev.id}/`, over: 'Previous position', title: prev.title } : { href: `${base}${last.id}/`, over: `Principle ${last.n}`, title: last.title };
const pNext = next ? { href: `${base}positions/${next.id}/`, over: 'Next position', title: next.title } : { href: base, over: `Back to ${issueLabel(f)}`, title: `The ${f.name}` };
---
<Base title={title} description={description} ids={['9v9-hub', f.registerId]} nav="9v9" crumbs={crumbs} jsonLd={jsonLd} editorial meta={{ type: 'position', format: f.format, issue: f.issue && f.issue.number, formation: f.slug, group: 'Positions' }}>
  <EdGuideNav f={f} current={'pos-' + r.id} />
  <article aria-labelledby="pos-h">
    <div class="feature feature--pos ed-grid" style="padding-top:var(--ed-s4)">
      <div class="feature__rail" aria-hidden="true"><span class="feature__num">{folio}</span><p>{where}<br>{issueLabel(f)} · {f.name}</p></div>
      <header class="feature__head" data-num={folio}>
        <p class="ed-kicker feature__kicker">9v9 · {issueLabel(f)} · {where}</p>
        <h1 class="feature__title" id="pos-h">{r.title}</h1>
        <p class="ed-stand">{r.head}</p>
      </header>
      <div class="feature__body">
        {exploratory && <Fragment set:html={exploratoryStrip()} />}
        <LessonFigure id="pos-fig" frames={set.frames} figLabel={`${r.nums.join(' · ')} · ${r.title}`} context={`9v9 · ${f.name}`} source={roleSource}>
          <div class="ed-cue"><p>Ask yourself</p><blockquote>{r.cue}</blockquote></div>
          <div class="ed-chips" set:html={statusChips(f.register)} />
          <Byline f={f} />
        </LessonFigure>
      </div>
    </div>

    <section class="ed-section ed-grid split" aria-label="The job in detail">
      <div class="split__main jobs">
        <h2 class="ed-label" id="jobs-h">Your jobs</h2>
        <ol class="looks" aria-labelledby="jobs-h">{r.points.map(p => <li>{p}</li>)}</ol>
        {r.steps && <><h2 class="ed-label" id="steps-h" style="margin:28px 0 10px">Carry it forward</h2><ol class="looks" aria-labelledby="steps-h">{r.steps.map(s => <li>{s}</li>)}</ol></>}
        {reviews.map(rv => <div data-hwp-reviewer-only style="margin-top:16px" set:html={reviewNote('Needs coach review:', rv.qs[0])} />)}
      </div>
      {related.length > 0 && (
        <div class="split__side sheet__col">
          <h2 class="ed-label" id="rel-h" style="margin-bottom:4px">Principles this position uses</h2>
          <ol class="rulelist" aria-labelledby="rel-h">{related.map(x => <li><a href={`${base}${x.id}/`}><b>Principle {x.n}</b><strong>{x.title}</strong><i>{x.cue}</i></a></li>)}</ol>
        </div>
      )}
      {r.situations && (
        <div class="situ" style="grid-column:1/-1">{r.situations.map(([h, t]) => <section><h3>{h}</h3><p>{t}</p></section>)}</div>
      )}
    </section>

    <nav class="ed-section ed-grid" aria-label="Other positions">
      <div class="ed-pager">
        <a href={pPrev.href}><small>{pPrev.over}</small><b>{pPrev.title}</b></a>
        <a href={pNext.href}><small>{pNext.over}</small><b>{pNext.title}</b></a>
      </div>
    </nav>
  </article>
</Base>
