---
/* The 9v9 collection: each formation is a complete guide. Published issues get their team sheet; issues still in
 * preparation are named with their number and status only (linked in preview builds for the reviewer). */
import Base from '../../../layouts/Base.astro';
import Gated from '../../../components/Gated.astro';
import TeamSheet from '../../../components/TeamSheet.astro';
import Scoreboard from '../../../components/Scoreboard.astro';
import Facts from '../../../components/Facts.astro';
import model from '../../../lib/content.mjs';
import { longDate, checklist } from '../../../lib/ui.mjs';
import { issueLabel } from '../../../lib/editorial.mjs';
import { collectionStructuredData } from '../../../lib/seo.mjs';

const issues = model.formations.filter(f => f.format === '9v9' && f.issue).sort((a, b) => a.issue.number - b.issue.number);
const published = issues.filter(f => f.register.content.status === 'reviewed' && f.gate.allowed);
const preparing = issues.filter(f => !published.includes(f));
const preview = model.target !== 'public';
const fact = id => model.fact(id);
const glance = [
  ['Age groups', 'U12 and U13'],
  ['Players', '9 a side, including the goalkeeper'],
  ['Recommended pitch', fact('pitch').v9],
  ['Goals', fact('goals').v9],
  ['Ball', fact('ball').v9],
  ['Offside', fact('offside').v9]
];
const ex = fact('example-shapes');
const byGroup = g => model.facts.facts.filter(x => x.group === g).map(x => x.id);
const crumbs = [{ label: 'Home', href: '/' }, { label: '9v9 formations' }];
const ids = ['9v9-hub', 'moving-up-7v7-9v9', ...published.map(f => f.registerId)];
const jsonLd = collectionStructuredData(model.site, published);
---
<Base title="9v9 football formations for grassroots coaches | How We Play Football" description="9v9 football formations for U12 and U13: formation guides with playing principles and positions, plus what changes when moving up from 7v7." ids={ids} nav="9v9" crumbs={crumbs} jsonLd={jsonLd} ogType="website" editorial meta={{ type: 'format', format: '9v9', group: 'Formats' }}>
  <div class="page-head ed-grid">
    <div class="page-head__text">
      <p class="ed-kicker">Format · U12 and U13</p>
      <h1>9v9 formations</h1>
      <p class="ed-stand">Each 9v9 formation is a complete guide: a starting shape, four playing principles, a job for every position and how the team plays together. There's no single correct formation; each one is a starting point that adapts to your players.</p>
      <p class="ed-small usa-format-link">Coaching in the USA? 9v9 is generally the U11–U12 format. <a href="/coaching-in-the-usa/">See the US age-group guide →</a></p>
    </div>
    <div class="page-head__aside">
      <dl class="glance" aria-label="9v9 at a glance">{glance.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
      <span class="hwp-chip hwp-chip--verified">Official rule verified · {longDate(fact('pitch').checkedOn)}</span>
    </div>
  </div>

  {published.map(f => (
    <section class="ed-section" aria-label={`${issueLabel(f)}: the ${f.name}`}>
      <div class="ed-grid"><div class="ed-sh"><p class="ed-label">9v9 · {issueLabel(f)} · Published</p><span class="ed-label" style="color:var(--hwp-text-secondary)">Four principles · {f.roles.length} positions</span></div></div>
      <TeamSheet f={f} third="rules" />
      <div class="ed-grid" style="margin-top:20px"><p style="grid-column:1/-1"><a class="ed-btn" href={`/formations/9v9/${f.slug}/`}>Explore the {f.name} guide →</a></p></div>
    </section>
  ))}
  {published.length === 0 && (
    <div class="ed-grid ed-section"><p class="ed-lede" style="grid-column:1/span 7">Our first 9v9 guide is with our coaching reviewer and will appear here once his review is recorded. In the meantime, <a href="#moving-up">what changes at nine a side</a> is below.</p></div>
  )}

  {preparing.length > 0 && <section class="ed-section" aria-labelledby="h-next">
    <div class="ed-grid split">
      <div class="shelf">
        <p class="ed-kicker">In preparation</p>
        <h2 class="ed-h2" id="h-next" style="margin-top:12px">Coming guides</h2>
        <p class="ed-lede">We publish a formation guide only after its coaching review is recorded, so these aren't available yet.</p>
        <p class="ed-small" style="color:var(--hwp-text-secondary)">{ex.fact}. Ours are one way among several.</p>
      </div>
      <div class="shelf__side">
        <ol class="issue-list" aria-label="9v9 formation guides in preparation">
          {preparing.map(f => {
            const inner = <><b>{f.format}</b><span><strong>The {f.name}</strong><em>{f.register.content.exploratory ? 'Exploratory · in preparation' : 'In preparation'}</em></span></>;
            return <li>{preview && f.gate.allowed ? <a href={`/formations/9v9/${f.slug}/`}>{inner}</a> : <div>{inner}</div>}</li>;
          })}
        </ol>
      </div>
    </div>
  </section>}

  <div class="ed-section" id="moving-up">
    <Scoreboard ids={[...byGroup('game'), ...byGroup('rules'), ...byGroup('competition')]} kicker="Moving up from 7v7" title="What changes at nine a side" id="score" from="7v7" to="9v9">
      <p class="ed-small">If your team is stepping up, start here: what your players know, beside what they're moving into. Two more players, a bigger pitch, and offside and heading for the first time.</p>
    </Scoreboard>
  </div>

  <section class="ed-section ed-grid split" aria-labelledby="h-same">
    <div class="split__main">
      <p class="ed-kicker">What stays familiar</p>
      <h2 class="ed-h2" id="h-same" style="margin:12px 0 20px">Same game, bigger pitch</h2>
      <Facts ids={['subs', 'playing-time', 'positions', 'smaller-formats']} />
    </div>
    <div class="split__side">
      <p class="ed-small">The formation guides above are one way to start at nine a side. {ex.fact}.</p>
    </div>
  </section>

  <Gated ids={['moving-up-checklist']}>
    <section class="ed-section ed-grid" id="checklist" aria-labelledby="h-check">
      <div style="grid-column:1/-1" class="flow">
        <div class="ed-sh"><h2 class="ed-label" id="h-check">Before pre-season (draft, preview only)</h2></div>
        <div class="two-col">{model.checklist.groups.map((g, k) => <Fragment set:html={checklist(g.items.map(x => `${x.text}. ${x.detail}`), { id: `nine-${k}`, title: g.heading })} />)}</div>
      </div>
    </section>
  </Gated>
</Base>
