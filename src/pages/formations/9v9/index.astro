---
import Base from '../../../layouts/Base.astro';
import Facts from '../../../components/Facts.astro';
import Gated from '../../../components/Gated.astro';
import model from '../../../lib/content.mjs';
import { formationComparison, statusChips, exploratoryStrip } from '../../../lib/ui.mjs';

// Public builds only ever see formations the gate allows; preview builds see all three, marked.
const list = model.target === 'public' ? model.publicFormations : model.formations;
const panels = list.map(f => ({
  name: f.name,
  shape: { ...f.shape, title: `${f.name} starting shape`, altSummary: f.shape.altSummary || f.shape.alt },
  facts: f.structure.filter(([k]) => k !== 'Notation'),
  chips: statusChips(f.register) + (f.register.content.exploratory ? exploratoryStrip() : ''),
  href: `/formations/9v9/${f.slug}/`,
  exploratory: !!f.register.content.exploratory
}));
const rowsFor = key => list.map(f => (f.structure.find(([k]) => k === key) || [key, '—'])[1]);
const structureRows = ['Notation', 'Back line', 'Wing-backs', 'Midfield', 'Forwards'].filter(k => list.some(f => f.structure.some(([x]) => x === k)));
const crumbs = [{ label: 'Home', href: '/' }, { label: '9v9 formations' }];
const ids = ['9v9-hub', ...list.map(f => f.registerId)];
---
<Base title="9v9 football formations for grassroots coaches | How We Play" description="9v9 is the maximum format for U12 and U13. Compare starting shapes for 9v9 football, with clear diagrams, four simple rules per formation and a job for every position." ids={ids} nav="9v9" activeFormat="9v9" crumbs={crumbs}>
  <div class="guide-head">
    <div class="flow">
      <p class="hwp-label over">Format · U12 and U13</p>
      <h1 class="hwp-heading-l">9v9 formations</h1>
      <p class="hwp-standfirst">A formation is a starting picture: where nine players begin before the ball moves. Our guides set out a few ways to start, each drawn on the same pitch with the same symbols.</p>
      <p class="lede">There's no single correct 9v9 formation. Each guide is one possible way to play, with its own starting shape, four simple rules and a job for every position.</p>
    </div>
    <div class="flow">
      <h2 class="hwp-heading-m">9v9 at a glance</h2>
      <Facts ids={['format-ages', 'pitch', 'goals', 'ball', 'offside', 'example-shapes']} />
    </div>
  </div>

  <section class="section" aria-labelledby="h-compare">
    <div class="hwp-section-divider hwp-rule-section"><span class="hwp-label">The formations</span><span class="hwp-label hwp-secondary">Same pitch, same scale</span></div>
    <h2 class="hwp-heading-l" id="h-compare">Three starting pictures</h2>
    {list.length === 0 ? (
      <div class="hwp-review-note" role="note"><strong>Formation guides in coaching review.</strong> Our 9v9 formation guides are waiting for review by a qualified coach. Each will appear here once it has been reviewed. In the meantime, <a href="/moving-up/">Moving Up</a> explains what changes from 7v7.</div>
    ) : (
      <>
        <Gated ids={list.map(f => f.registerId)} exploratoryStrip={false}>
          <Fragment set:html={formationComparison(panels)} />
          <div class="flow">
            <h3 class="hwp-heading-m">How the shapes differ</h3>
            <p class="hwp-small hwp-secondary measure" style="margin:0">Structure only: how many players start in each line. This isn't a judgement about which shape is better.</p>
            <div class="table-scroll" role="region" aria-label="Table: formation structures compared" tabindex="0">
              <table>
                <caption class="hwp-sr-only">Starting structure of each 9v9 formation</caption>
                <thead><tr><th scope="col">Line</th>{list.map(f => <th scope="col">{f.name}</th>)}</tr></thead>
                <tbody>{structureRows.map(k => <tr><th scope="row">{k}</th>{rowsFor(k).map(v => <td>{v}</td>)}</tr>)}</tbody>
              </table>
            </div>
          </div>
          {model.target !== 'public' && <div class="flow" data-hwp-reviewer-only>
            <h3 class="hwp-heading-m">Coaching considerations</h3>
            <div class="hwp-review-note" role="note"><strong>Proposed, not reviewed.</strong> These are the drafts' own notes on what each shape offers and costs. A qualified coach hasn't checked them yet.</div>
            <div class="placeholders">
              {list.map(f => (
                <div class={`placeholder${f.register.content.exploratory ? ' hwp-exploratory-frame' : ''}`}>
                  {f.register.content.exploratory && <Fragment set:html={exploratoryStrip()} />}
                  <h4 class="hwp-heading-m" style="font-size:22px">{f.name}</h4>
                  {f.considerations ? (
                    <>
                      <p class="hwp-label">{f.considerations.label}</p>
                      <p class="hwp-small" style="margin:0"><strong>May offer:</strong> {f.considerations.strengths.join('; ')}.</p>
                      <p class="hwp-small" style="margin:0"><strong>May cost:</strong> {f.considerations.tradeoffs.join('; ')}.</p>
                    </>
                  ) : (
                    <>
                      <p class="hwp-label">From the source playbook</p>
                      <p class="hwp-small" style="margin:0"><strong>Gives us:</strong> {f.gives.join('; ')}.</p>
                      <p class="hwp-small" style="margin:0"><strong>Costs:</strong> not in the source. Question for the reviewer.</p>
                    </>
                  )}
                </div>
              ))}
            </div>
          </div>}
        </Gated>
      </>
    )}
  </section>

  <section class="section" aria-labelledby="h-moving">
    <div class="hwp-section-divider hwp-rule-section"><span class="hwp-label">Moving up</span></div>
    <div class="two-col">
      <h2 class="hwp-heading-m" id="h-moving">New to 9v9?</h2>
      <p class="lede">If your team is stepping up from 7v7, start with what changes: a bigger pitch, two more players, offside and heading. <a href="/moving-up/">Read Moving Up</a>.</p>
    </div>
  </section>
</Base>
