---
/* 9v9 hub. Reflects what exists: the reviewed guide(s) as team sheets, and a development shelf that names
 * unreviewed formations with their status only. No shapes, rules or comparisons of unreviewed work in a
 * public build. Preview builds show the drafts' team sheets too, marked by the gate. */
import Base from '../../../layouts/Base.astro';
import Gated from '../../../components/Gated.astro';
import TeamSheet from '../../../components/TeamSheet.astro';
import model from '../../../lib/content.mjs';
import { longDate } from '../../../lib/ui.mjs';
import { developmentShelf, word } from '../../../lib/editorial.mjs';

const list = model.target === 'public' ? model.publicFormations : model.formations;
const shelf = developmentShelf(model);
const fact = id => model.fact(id);
const glance = [
  ['Age groups', 'U12 and U13'],
  ['Players', '9 a side, including the goalkeeper'],
  ['Recommended pitch', fact('pitch').v9],
  ['Goals', fact('goals').v9],
  ['Ball', fact('ball').v9],
  ['Offside', fact('offside').v9]
];
const ex = fact('example-shapes');
const crumbs = [{ label: 'Home', href: '/' }, { label: '9v9 formations' }];
const ids = ['9v9-hub', ...list.map(f => f.registerId)];
const count = list.length;
---
<Base title="9v9 football formations for grassroots coaches | How We Play" description="9v9 is the maximum format for U12 and U13. Starting shapes for 9v9 football, with clear diagrams, four simple rules per formation and a job for every position." ids={ids} nav="9v9" crumbs={crumbs} editorial>
  <div class="page-head ed-grid">
    <div class="page-head__text">
      <p class="ed-kicker">Format · U12 and U13</p>
      <h1>9v9 formations</h1>
      <p class="ed-stand">A formation is a starting picture: where nine players begin before the ball moves. There's no single correct one, and each guide here is one possible way to play.</p>
    </div>
    <div class="page-head__aside">
      <dl class="glance" aria-label="9v9 at a glance">{glance.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
      <span class="hwp-chip hwp-chip--verified">Official rule verified · {longDate(fact('pitch').checkedOn)}</span>
    </div>
  </div>

  <section class="ed-section" aria-labelledby="h-available">
    <div class="ed-grid"><div class="ed-sh"><h2 class="ed-label" id="h-available">{count === 0 ? 'Guides in review' : `Available now · ${word(count)} guide${count === 1 ? '' : 's'}`}</h2><span class="ed-label" style="color:var(--hwp-text-secondary)">Same pitch, same symbols</span></div></div>
    {count === 0 ? (
      <div class="ed-grid"><p class="ed-lede" style="grid-column:1/span 7">Our 9v9 formation guides are waiting for coaching review. Each will appear here once its review is recorded. In the meantime, <a href="/moving-up/">Moving Up</a> explains what changes from 7v7.</p></div>
    ) : list.map((f, i) => (
      <div style={i ? 'margin-top:var(--ed-s5)' : undefined}>
        <Gated ids={[f.registerId]}>
          <TeamSheet f={f} third="rules" />
          <div class="ed-grid" style="margin-top:var(--ed-s3)"><p style="grid-column:1/-1"><a class="ed-btn" href={`/formations/9v9/${f.slug}/`}>Open the {f.name} guide →</a></p></div>
        </Gated>
      </div>
    ))}
  </section>

  <section class="ed-section" aria-labelledby="h-dev">
    <div class="ed-grid split">
      <div class="shelf">
        <p class="ed-kicker">In development</p>
        <h2 class="ed-h2" id="h-dev" style="margin-top:12px">More shapes, once they're reviewed</h2>
        <p class="ed-lede">We only publish a formation after its coaching review is recorded. The guides listed here are being written or reviewed, so they aren't shown yet.</p>
        <p class="ed-small" style="color:var(--hwp-text-secondary)">{ex.fact}. Ours are one way among several.</p>
      </div>
      <div class="shelf__side">
        <ul class="devlist" aria-label="Guides in development">{shelf.map(x => <li>{x.name} <em>{x.status}</em></li>)}</ul>
        <p class="ed-small">New to nine a side? <a href="/moving-up/">What changes from 7v7</a>.</p>
      </div>
    </div>
  </section>
</Base>
