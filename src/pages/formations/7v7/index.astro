---
/* 7v7 magazine collection. Draft issues are visible only in private,
 * noindex builds until coaching review is recorded. The public 7v7
 * landing stays an honest placeholder until the first approved issue. */
import Base from '../../../layouts/Base.astro';
import TeamSheet from '../../../components/TeamSheet.astro';
import SevenV7Comparison from '../../../components/SevenV7Comparison.astro';
import model from '../../../lib/content.mjs';
import { issueLabel } from '../../../lib/editorial.mjs';
import { collectionStructuredData } from '../../../lib/seo.mjs';

const format = '7v7';
const fm = model.site.formats.find(x => x.id === format);
const issues = model.formations.filter(f => f.format === format && f.issue).sort((a, b) => a.issue.number - b.issue.number);
const published = issues.filter(f => f.register.content.status === 'reviewed' && f.gate.allowed && !!f.issue.published);
const preparing = issues.filter(f => !published.includes(f));
const preview = model.target !== 'public';
const fact = id => model.fact(id);
const crumbs = [{ label: 'Home', href: '/' }, { label: '7v7 formations' }];
const title = published.length ? '7v7 Football Formations: Compare 3 Shapes | How We Play Football' : '7v7 football formations: in development | How We Play Football';
const description = published.length ? 'Compare 2-3-1, 3-2-1 and 2-1-2-1 formations for 7v7 football and youth soccer. Free pitch diagrams, coaching principles and player roles.' : 'Our 7v7 formation guides are being researched and reviewed. Explore the format and our published football coaching guides.';
const glance = [
  ['Age groups', 'U10 and U11'],
  ['Players', '7, including a goalkeeper'],
  ['Pitch', fact('pitch').v7],
  ['Goals', fact('goals').v7],
  ['Ball', fact('ball').v7],
  ['Offside', 'No offside']
];
const jsonLd = published.length ? collectionStructuredData(model.site, published, '7v7') : [];
---
<Base
  title={title}
  description={description}
  ids={['7v7']}
  nav="7v7"
  crumbs={crumbs}
  jsonLd={jsonLd}
  ogType="website"
  editorial
  noindex={published.length === 0}
  meta={{ type: 'format', format: '7v7', group: 'Formats' }}
>
  <header class="page-head ed-grid">
    <div class="page-head__text">
      <p class="ed-kicker">Format · U10 and U11 in England</p>
      <h1>7v7 formations</h1>
      <p class="ed-stand">Moving from 5v5, or working through another season at 7v7? Compare three illustrated formations to see how they give your players width, passing options and cover. Choose a starting shape, then explore the full guide for four playing principles and every player’s job.</p>
      {published.length > 0 && <a class="ed-go seven-hub__jump" href="#compare-7v7">Compare the three formations ↓</a>}
      <p class="ed-small">Still coaching five a side? <a href="/formations/5v5/">Compare our 1-2-1 and 2-2 formation guides</a> before moving up.</p>
      <p class="ed-small usa-format-link">Coaching in the USA? 7v7 is generally the U9–U10 format. <a href="/coaching-in-the-usa/">See the US age-group guide →</a></p>
    </div>
    <div class="page-head__aside">
      <dl class="glance" aria-label="7v7 at a glance">{glance.map(([k,v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
      <p class="ed-small">These format rules are from <a href="https://learn.englandfootball.com/articles-and-resources/coaching/resources/2025/How-to-play-and-manage-7v7-games" target="_blank" rel="noopener noreferrer">England Football Learning</a> for the 2026/27 season. Always check your competition's current rules.</p>
    </div>
  </header>

  <SevenV7Comparison issues={published} />

  {published.length > 0 && (
    <section class="ed-section ed-grid split" aria-labelledby="seven-next-season">
      <div class="split__main">
        <p class="ed-kicker">Keep developing</p>
        <h2 class="ed-h2" id="seven-next-season">Another season at 7v7?</h2>
        <p class="ed-lede">Progress does not have to mean changing formation. Help players recognise when to offer a passing angle, support a teammate or protect the space behind the ball.</p>
      </div>
      <div class="split__side">
        <p class="ed-small">The <a href="/formations/7v7/2-1-2-1/">2-1-2-1 guide</a> explores a defined link between defence and attack. In the <a href="/formations/7v7/3-2-1/">3-2-1 guide</a>, an outside defender can join attacks while two teammates protect. Use these as ideas to discuss and practise with your players, not fixed rules.</p>
        <p class="ed-small">If you are still working on familiar decisions, the <a href="/formations/7v7/2-3-1/">2-3-1 guide</a> includes giving two passing options and recovering together when the ball is lost.</p>
      </div>
    </section>
  )}

  {published.length > 0 && (
    <section class="ed-section ed-grid split" aria-labelledby="7v7-next-steps">
      <div class="split__main">
        <p class="ed-kicker">Beyond the starting shape</p>
        <h2 class="ed-h2" id="7v7-next-steps">What should we work on next?</h2>
        <p class="ed-small">Once you've chosen a formation, explore a matchday situation or see what changes when your team eventually moves up to nine a side.</p>
      </div>
      <div class="split__side">
        <p class="ed-small"><a href="/coaching/attacking-corners/">How to set up for attacking corners in 7v7</a>, with a simple illustrated example.</p>
        <p class="ed-small"><a href="/coaching/moving-from-7v7-to-9v9-england/">Moving from 7v7 to 9v9?</a> Read the full England 2026/27 guide to pitch, offside and restarts, or <a href="/formations/9v9/#moving-up">compare the formats at a glance</a>.</p>
      </div>
    </section>
  )}

  {preview && preparing.map(f => (
    <section class="ed-section" aria-label={`${issueLabel(f)}: the ${f.name}, private research draft`} data-hwp-reviewer-only>
      <div class="ed-grid"><div class="ed-sh"><p class="ed-label">7v7 · {issueLabel(f)} · Private coaching review</p><span class="ed-label" style="color:var(--hwp-text-secondary)">Unreviewed research draft, not for publication</span></div></div>
      <TeamSheet f={f} third="rules"/>
      <div class="ed-grid" style="margin-top:20px"><p style="grid-column:1/-1"><a class="ed-btn" href={`/formations/7v7/${f.slug}/`}>Open private draft: the {f.name} →</a></p></div>
    </section>
  ))}

  {published.length === 0 && (
    <section class="ed-section ed-grid split" aria-labelledby="7v7-next">
      <div class="split__main">
        <p class="ed-kicker">In preparation</p>
        <h2 class="ed-h2" id="7v7-next">Our first 7v7 guide</h2>
        <p class="ed-lede">We're working on the 2-3-1 formation. The full guide, principles and diagrams will appear once the coaching review is complete.</p>
        <p class="ed-small">England Football illustrates both 1-2-3-1 and 1-3-2-1 (goalkeeper included) as possible 7v7 starting shapes. Neither is prescribed as the only way to play.</p>
      </div>
      <div class="split__side">
        <p class="ed-label">Published guides now</p>
        <p class="ed-small">In the meantime, <a href="/formations/9v9/">explore our 9v9 formation guides</a>.</p>
      </div>
    </section>
  )}

  {published.length > 0 && preparing.length > 0 && (
    <section class="ed-section ed-grid split" aria-labelledby="7v7-preparing">
      <div class="split__main"><p class="ed-kicker">Coming next</p><h2 class="ed-h2" id="7v7-preparing">Guides in preparation</h2><p class="ed-small">Unreviewed formation guides are not published.</p></div>
      <div class="split__side">
        <ol class="issue-list">
          {preparing.map(f => <li><div><b>{f.format}</b><span><strong>The {f.name}</strong><em>In preparation</em></span></div></li>)}
        </ol>
      </div>
    </section>
  )}
</Base>
