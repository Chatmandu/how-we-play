---
/* Contact the editor. This page never reveals the current private inbox.
 * The Worker API's verified destination is configured in wrangler.jsonc.
 */
import Base from '../../layouts/Base.astro';

const crumbs = [{ label: 'Home', href: '/' }, { label: 'Contact' }];
const topics = [
  ['coaching', 'A question about coaching'],
  ['feedback', 'Feedback or an idea'],
  ['website', 'A problem with the website'],
  ['privacy', 'Privacy enquiry'],
  ['other', 'Something else']
];
---
<Base title="Contact How We Play | Grassroots Football Coaching" description="Have a question about a How We Play formation guide, an idea or feedback? Get in touch with the grassroots coach behind the publication." ids={['about']} nav="contact" crumbs={crumbs} editorial meta={{ type: 'contact', group: 'About' }}>
  <header class="page-head ed-grid">
    <div class="page-head__text">
      <p class="ed-kicker">From one touchline to another</p>
      <h1>Get in touch.</h1>
      <p class="ed-stand">Got a question about a guide, spotted something that doesn't look right, or have an idea for what we should cover next? I'd love to hear from you.</p>
    </div>
  </header>

  <section class="ed-grid contact-layout" aria-label="Contact form">
    <div class="contact-layout__main">
      <form class="contact-form" id="contact-form" action="/api/contact" method="post" data-contact>
        <p class="contact-form__intro">Send a message</p>
        <div class="contact-form__fields">
          <div class="contact-form__field">
            <label for="contact-name">Your name <span aria-hidden="true">*</span></label>
            <input id="contact-name" name="name" type="text" autocomplete="name" minlength="1" maxlength="90" required>
          </div>
          <div class="contact-form__field">
            <label for="contact-email">Email address <span aria-hidden="true">*</span></label>
            <input id="contact-email" name="email" type="email" autocomplete="email" inputmode="email" maxlength="254" required spellcheck="false">
          </div>
          <div class="contact-form__field">
            <label for="contact-topic">What's it about? <span aria-hidden="true">*</span></label>
            <select id="contact-topic" name="topic" required>
              <option value="">Choose a topic</option>
              {topics.map(([id, text]) => <option value={id}>{text}</option>)}
            </select>
          </div>
          <div class="contact-form__field">
            <label for="contact-message">Your message <span aria-hidden="true">*</span></label>
            <textarea id="contact-message" name="message" rows="7" minlength="10" maxlength="4000" placeholder="What would you like to ask or share?" required aria-describedby="contact-message-help"></textarea>
            <p class="contact-form__help" id="contact-message-help">10–4,000 characters. Please don't include children's personal details or sensitive information.</p>
          </div>
        </div>

        <div class="contact-form__trap" aria-hidden="true">
          <label for="contact-website">Leave this field empty</label>
          <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off">
        </div>

        <p class="contact-form__privacy">Your details will only be used to respond to your enquiry, not to add you to a mailing list. See our <a href="/privacy/#contact">privacy notice</a>.</p>
        <div class="contact-form__send">
          <button class="ed-btn contact-form__button" type="submit">Send message →</button>
          <p class="contact-form__status" id="contact-status" role="status" aria-live="polite" aria-atomic="true"></p>
        </div>
      </form>
    </div>

    <aside class="contact-layout__aside" aria-labelledby="contact-aside-h">
      <p class="ed-kicker">A note from the touchline</p>
      <h2 id="contact-aside-h">It's a conversation.</h2>
      <p>How We Play is an independent project built around practical, straightforward football coaching.</p>
      <p>Whether you're new to coaching or you've been doing it for years, questions and suggestions are always welcome.</p>
      <p>I coach alongside running this project, so replies might not be immediate. But I'll read your message and get back to you when I can.</p>
      <p class="contact-layout__note">For coaching resources, have a look at the <a href="/formations/9v9/">9v9 issues</a>. For how the project began, read the <a href="/about/">About page</a>.</p>
    </aside>
  </section>
</Base>

<style>
  .contact-layout { padding-block: var(--ed-s3) var(--ed-s6); gap: var(--ed-s4); }
  .contact-layout__main { grid-column: 1 / span 7; min-width: 0; }
  .contact-layout__aside { grid-column: 9 / -1; min-width: 0; padding-top: var(--ed-s2); }
  .contact-layout__aside h2 { font: 900 clamp(30px, 4vw, 48px)/.98 var(--ed-display); text-transform: uppercase; margin: 14px 0 24px; }
  .contact-layout__aside p { font: 400 17px/1.65 var(--ed-sans); margin: 0 0 18px; }
  .contact-layout__aside .ed-kicker { font-size: 12px; }
  .contact-layout__note { border-top: 2px solid var(--hwp-color-ink); padding-top: 18px; margin-top: 28px !important; }
  .contact-form { border-top: 5px solid var(--hwp-color-ink); padding-top: 16px; }
  .contact-form__intro { font: 900 34px/1 var(--ed-display); text-transform: uppercase; margin: 0 0 26px; }
  .contact-form__fields { display: grid; gap: 22px; }
  .contact-form__field { display: grid; gap: 8px; }
  .contact-form__field label { font: 700 16px/1.3 var(--ed-sans); }
  .contact-form__field label span { color: var(--hwp-color-pitch-blue); }
  .contact-form__field input, .contact-form__field select, .contact-form__field textarea {
    display: block; box-sizing: border-box; width: 100%; border: 1px solid var(--hwp-color-ink);
    border-radius: 0; background: #fff; color: var(--hwp-color-ink);
    padding: 13px 14px; font: 400 16px/1.5 var(--ed-sans);
  }
  .contact-form__field textarea { resize: vertical; min-height: 155px; }
  .contact-form__field input:focus-visible, .contact-form__field select:focus-visible,
  .contact-form__field textarea:focus-visible { outline: 3px solid var(--hwp-color-pitch-blue); outline-offset: 3px; }
  .contact-form__field :is(input,select,textarea)[aria-invalid="true"] { border-color: #AC2626; border-width: 2px; }
  .contact-form__help, .contact-form__privacy { color: var(--hwp-text-secondary); font: 400 14px/1.5 var(--ed-sans); margin: 0; }
  .contact-form__privacy { margin-top: 26px; }
  .contact-form__send { display: flex; align-items: flex-start; flex-wrap: wrap; gap: 16px; margin-top: 20px; }
  .contact-form__button { cursor: pointer; min-height: 48px; }
  .contact-form__button:disabled { opacity: .6; cursor: wait; }
  .contact-form__status { margin: 0; flex: 1 1 220px; font: 600 15px/1.5 var(--ed-sans); }
  .contact-form__status[data-state="success"] { color: var(--hwp-color-ink); }
  .contact-form__status[data-state="error"] { color: #942421; }
  .contact-form__trap { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  @media (max-width: 899px) {
    .contact-layout__main, .contact-layout__aside { grid-column: 1 / -1; }
    .contact-layout__aside { padding-top: 12px; border-top: 1px solid var(--hwp-color-rule); }
    .contact-layout__aside h2 { margin-bottom: 16px; }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('form[data-contact]');
  if (form) {
    const status = form.querySelector<HTMLElement>('.contact-form__status');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    form.addEventListener('submit', async event => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      if (!status || !button) return;
      button.disabled = true;
      status.dataset.state = '';
      status.textContent = 'Sending your message…';
      try {
        const data = new URLSearchParams();
        new FormData(form).forEach((value, name) => data.append(name, String(value)));
        const response = await fetch(form.action, {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Accept': 'application/json', 'Content-Type': 'application/x-www-form-urlencoded' },
          body: data.toString()
        });
        const result = await response.json();
        if (!response.ok || !result.ok) throw new Error(result.message || "Your message couldn't be sent.");
        status.dataset.state = 'success';
        status.textContent = result.message;
        form.reset();
      } catch (error) {
        status.dataset.state = 'error';
        status.textContent = error instanceof Error ? error.message : 'Your message could not be sent. Please try again shortly.';
      } finally {
        button.disabled = false;
      }
    });
  }
</script>
