---
import Base from '../../layouts/Base.astro';
import Facts from '../../components/Facts.astro';
import Gated from '../../components/Gated.astro';
import model from '../../lib/content.mjs';
import { checklist } from '../../lib/ui.mjs';

const groups = model.checklist.groups;
const facts = model.facts.facts;
const byGroup = g => facts.filter(f => f.group === g).map(f => f.id);
const crumbs = [{ label: 'Home', href: '/' }, { label: 'Moving up' }];
---
<Base title="Moving from 7v7 to 9v9 football: what changes | How We Play" description="Moving your team from 7v7 to 9v9? What changes, what stays the same and what to check before pre-season. Rules checked against England Football for 2026/27." ids={['moving-up', 'moving-up-7v7-9v9']} nav="moving-up" crumbs={crumbs}>
  <div class="guide-head">
    <div class="flow">
      <p class="hwp-label over">Moving up</p>
      <h1 class="hwp-heading-l">Moving from 7v7 to 9v9</h1>
      <p class="hwp-standfirst">Two more players, a much bigger pitch and offside for the first time. A lot also stays the same, and that's the place to start.</p>
      <ul class="list lede">
        <li><strong>Bigger:</strong> the recommended pitch has about two-thirds more grass.</li>
        <li><strong>New rules:</strong> offside, heading and throw-ins; no retreat line.</li>
        <li><strong>Same game:</strong> support, space, protect the goal, decide.</li>
      </ul>
    </div>
    <div class="flow">
      <h2 class="hwp-heading-m">Other moves</h2>
      <p class="lede">Moving Up will cover each step between formats. 5v5 to 7v7 and 9v9 to 11v11 are planned and not written yet.</p>
      <div class="hwp-chips"><span class="hwp-chip hwp-chip--soon">5v5 → 7v7 · Coming soon</span><span class="hwp-chip hwp-chip--soon">9v9 → 11v11 · Coming soon</span></div>
    </div>
  </div>

  <section class="section" id="changes" aria-labelledby="h-changes">
    <div class="hwp-section-divider hwp-rule-section"><span class="hwp-label">What changes</span><span class="hwp-label hwp-secondary">7v7 → 9v9</span></div>
    <h2 class="hwp-heading-l" id="h-changes">What changes</h2>
    <div class="two-col">
      <div class="flow"><h3 class="hwp-heading-m">The game</h3><Facts ids={byGroup('game')} mode="compare" caption="The game: 7v7 compared with 9v9" /></div>
      <div class="flow"><h3 class="hwp-heading-m">New rules</h3><Facts ids={byGroup('rules')} mode="compare" caption="Rules: 7v7 compared with 9v9" /></div>
    </div>
    <div class="flow measure"><h3 class="hwp-heading-m">Competition</h3><Facts ids={byGroup('competition')} mode="compare" caption="Competition: 7v7 compared with 9v9" /></div>
  </section>

  <section class="section" id="same" aria-labelledby="h-same">
    <div class="hwp-section-divider hwp-rule-section"><span class="hwp-label">What stays familiar</span></div>
    <div class="two-col">
      <h2 class="hwp-heading-l" id="h-same">What stays familiar</h2>
      <Facts ids={['subs', 'playing-time', 'positions', 'smaller-formats']} />
    </div>
  </section>

  <section class="section" id="guides" aria-labelledby="h-guides">
    <div class="hwp-section-divider hwp-rule-section"><span class="hwp-label">Choosing a 9v9 shape</span></div>
    <div class="two-col">
      <h2 class="hwp-heading-m" id="h-guides">Picking a starting shape</h2>
      <div class="flow">
        <p class="lede">England Football's 9v9 guidance shows example shapes rather than a single correct one. Our 9v9 formation guides set out a few possibilities, each with four simple rules and a job for every position.</p>
        <p><a class="hwp-golink" href="/formations/9v9/">See the 9v9 formations →</a></p>
      </div>
    </div>
  </section>

  <Gated ids={['moving-up-checklist']}>
    <section class="section" id="checklist" aria-labelledby="h-check">
      <div class="hwp-section-divider hwp-rule-section"><span class="hwp-label">Before pre-season</span></div>
      <h2 class="hwp-heading-l" id="h-check">Pre-season checklist</h2>
      <p class="hwp-small hwp-secondary measure" style="margin:0">Ticks are kept on this device only. Two items ("Tell parents what is changing", "Note one thing to work on after each game") are our own additions and await review.</p>
      <div class="two-col">
        {groups.map((g, k) => <Fragment set:html={checklist(g.items.map(x => `${x.text}. ${x.detail}`), { id: `moving-up-${k}`, title: g.heading })} />)}
      </div>
    </section>
  </Gated>
</Base>
