{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "How We Play design tokens v1.0. Single source of truth. Edit here, then run `node tokens/build.mjs` to regenerate tokens.css. Values follow Design Specification v1.1.",
  "color": {
    "$type": "color",
    "paper": { "$value": "#F2EDE2", "$description": "Page background" },
    "white": { "$value": "#FFFFFF", "$description": "Raised surfaces, inputs, light pitch, print" },
    "ink": { "$value": "#0E1A24", "$description": "Text, rules, primary action" },
    "muted": { "$value": "#5C5E62", "$description": "Secondary text" },
    "rule": { "$value": "#D9D2C2", "$description": "Hairlines only, never text" },
    "pitch-blue": { "$value": "#2747E8", "$description": "Pitch, links, active format" },
    "pitch-line": { "$value": "#9DAEF5", "$description": "Markings on the blue pitch" },
    "pitch-line-light": { "$value": "#AEBBEF", "$description": "Markings on the light pitch" },
    "coral": { "$value": "#FF6B4A", "$description": "Opposition on blue, wrong verdict background. Never text." },
    "coral-deep": { "$value": "#D9472B", "$description": "Opposition on light pitch, error borders. Large text only." },
    "space-yellow": { "$value": "#F2D13C", "$description": "Key space, ball, stage labels, exploratory flag. Never text." },
    "space-edge": { "$value": "#9A7B00", "$description": "Key-space edge on light pitch" },
    "gap-grey": { "$value": "#5E6670", "$description": "Gap areas on light and mono pitch" }
  },
  "semantic": {
    "$type": "color",
    "surface": {
      "page": { "$value": "{color.paper}" },
      "raised": { "$value": "{color.white}" },
      "inverse": { "$value": "{color.ink}" },
      "pitch": { "$value": "{color.pitch-blue}" }
    },
    "text": {
      "primary": { "$value": "{color.ink}" },
      "secondary": { "$value": "{color.muted}" },
      "inverse": { "$value": "{color.paper}" },
      "on-pitch": { "$value": "{color.white}" },
      "link": { "$value": "{color.pitch-blue}" },
      "link-hover": { "$value": "{color.ink}" }
    },
    "border": {
      "strong": { "$value": "{color.ink}" },
      "subtle": { "$value": "{color.rule}" },
      "on-pitch": { "$value": "{color.pitch-line}" }
    },
    "action": {
      "primary-bg": { "$value": "{color.ink}" },
      "primary-text": { "$value": "{color.paper}" },
      "primary-bg-hover": { "$value": "{color.pitch-blue}" },
      "secondary-border": { "$value": "{color.ink}" },
      "on-pitch-bg": { "$value": "{color.white}" },
      "on-pitch-text": { "$value": "{color.pitch-blue}" }
    },
    "focus": {
      "ring": { "$value": "{color.pitch-blue}" },
      "ring-on-pitch": { "$value": "{color.space-yellow}" }
    },
    "status": {
      "draft-border": { "$value": "{color.muted}" },
      "draft-text": { "$value": "{color.muted}" },
      "review-border": { "$value": "{color.ink}" },
      "reviewed-border": { "$value": "{color.pitch-blue}" },
      "reviewed-text": { "$value": "{color.pitch-blue}" },
      "verified-bg": { "$value": "{color.ink}" },
      "verified-text": { "$value": "{color.paper}" },
      "exploratory-bg": { "$value": "{color.space-yellow}" },
      "exploratory-text": { "$value": "{color.ink}" },
      "coming-soon-text": { "$value": "{color.muted}" },
      "private-bg": { "$value": "{color.ink}" },
      "private-text": { "$value": "{color.space-yellow}" }
    },
    "verdict": {
      "wrong-bg": { "$value": "{color.coral}" },
      "wrong-text": { "$value": "{color.ink}" },
      "right-bg": { "$value": "{color.white}" },
      "right-text": { "$value": "{color.pitch-blue}" },
      "stage-bg": { "$value": "{color.space-yellow}" },
      "stage-text": { "$value": "{color.ink}" }
    },
    "feedback": {
      "error-border": { "$value": "{color.coral-deep}" },
      "success-border": { "$value": "{color.pitch-blue}" },
      "text": { "$value": "{color.ink}" }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "display": { "$value": "\"Big Shoulders Display\", \"Arial Narrow\", \"Helvetica Neue Condensed\", sans-serif" },
      "sans": { "$value": "\"Schibsted Grotesk\", system-ui, -apple-system, \"Segoe UI\", Helvetica, Arial, sans-serif" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": "400" },
      "medium": { "$value": "500" },
      "semibold": { "$value": "600" },
      "bold": { "$value": "700" },
      "extrabold": { "$value": "800" },
      "black": { "$value": "900" }
    }
  },
  "type": {
    "display-xl": { "family": { "$value": "{font.family.display}" }, "weight": { "$value": "900" }, "size": { "$value": "88px" }, "size-mobile": { "$value": "48px" }, "line-height": { "$value": "0.84" }, "case": { "$value": "uppercase" }, "tracking": { "$value": "0" } },
    "heading-l": { "family": { "$value": "{font.family.display}" }, "weight": { "$value": "900" }, "size": { "$value": "52px" }, "size-mobile": { "$value": "40px" }, "line-height": { "$value": "0.88" }, "case": { "$value": "uppercase" }, "tracking": { "$value": "0" } },
    "heading-m": { "family": { "$value": "{font.family.display}" }, "weight": { "$value": "800" }, "size": { "$value": "28px" }, "size-mobile": { "$value": "24px" }, "line-height": { "$value": "1" }, "case": { "$value": "uppercase" }, "tracking": { "$value": "0" } },
    "cue": { "family": { "$value": "{font.family.display}" }, "weight": { "$value": "900" }, "size": { "$value": "34px" }, "size-mobile": { "$value": "28px" }, "line-height": { "$value": "0.92" }, "case": { "$value": "uppercase" }, "tracking": { "$value": "0" } },
    "big-number": { "family": { "$value": "{font.family.display}" }, "weight": { "$value": "900" }, "size": { "$value": "96px" }, "size-mobile": { "$value": "72px" }, "line-height": { "$value": "0.78" }, "case": { "$value": "none" }, "tracking": { "$value": "0" } },
    "label": { "family": { "$value": "{font.family.display}" }, "weight": { "$value": "800" }, "size": { "$value": "13px" }, "size-mobile": { "$value": "13px" }, "line-height": { "$value": "1" }, "case": { "$value": "uppercase" }, "tracking": { "$value": "0.14em" } },
    "standfirst": { "family": { "$value": "{font.family.sans}" }, "weight": { "$value": "400" }, "style": { "$value": "italic" }, "size": { "$value": "21px" }, "size-mobile": { "$value": "19px" }, "line-height": { "$value": "1.4" }, "case": { "$value": "none" }, "tracking": { "$value": "0" } },
    "body": { "family": { "$value": "{font.family.sans}" }, "weight": { "$value": "400" }, "size": { "$value": "18px" }, "size-mobile": { "$value": "17px" }, "line-height": { "$value": "1.55" }, "case": { "$value": "none" }, "tracking": { "$value": "0" } },
    "small": { "family": { "$value": "{font.family.sans}" }, "weight": { "$value": "400" }, "size": { "$value": "15px" }, "size-mobile": { "$value": "15px" }, "line-height": { "$value": "1.5" }, "case": { "$value": "none" }, "tracking": { "$value": "0" } },
    "caption": { "family": { "$value": "{font.family.sans}" }, "weight": { "$value": "400" }, "style": { "$value": "italic" }, "size": { "$value": "16px" }, "size-mobile": { "$value": "15px" }, "line-height": { "$value": "1.4" }, "case": { "$value": "none" }, "tracking": { "$value": "0" } },
    "ui": { "family": { "$value": "{font.family.sans}" }, "weight": { "$value": "600" }, "size": { "$value": "16px" }, "size-mobile": { "$value": "16px" }, "line-height": { "$value": "1" }, "case": { "$value": "none" }, "tracking": { "$value": "0" } }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" }, "2": { "$value": "8px" }, "3": { "$value": "12px" }, "4": { "$value": "16px" },
    "5": { "$value": "24px" }, "6": { "$value": "32px" }, "7": { "$value": "48px" }, "8": { "$value": "64px" }, "9": { "$value": "96px" }
  },
  "layout": {
    "$type": "dimension",
    "container": { "$value": "1200px" },
    "measure": { "$value": "62ch" },
    "gutter-sm": { "$value": "20px" },
    "gutter-md": { "$value": "32px" },
    "gutter-lg": { "$value": "48px" },
    "column-gap": { "$value": "24px" },
    "split-min": { "$value": "380px" }
  },
  "breakpoint": {
    "$type": "dimension",
    "sm": { "$value": "600px" },
    "md": { "$value": "900px" },
    "lg": { "$value": "1200px" }
  },
  "border": {
    "$type": "dimension",
    "masthead": { "$value": "6px" },
    "section": { "$value": "1.5px" },
    "cue": { "$value": "4px" },
    "hair": { "$value": "1px" },
    "panel": { "$value": "1.5px" },
    "exploratory": { "$value": "4px" }
  },
  "radius": {
    "$type": "dimension",
    "none": { "$value": "0" },
    "input": { "$value": "2px" }
  },
  "size": {
    "$type": "dimension",
    "touch-target": { "$value": "44px" },
    "touch-target-comfortable": { "$value": "48px" },
    "icon": { "$value": "24px" },
    "icon-small": { "$value": "16px" },
    "focus-width": { "$value": "3px" },
    "focus-offset": { "$value": "2px" }
  },
  "motion": {
    "duration-fast": { "$type": "duration", "$value": "120ms" },
    "duration-base": { "$type": "duration", "$value": "200ms" },
    "duration-step": { "$type": "duration", "$value": "300ms" },
    "easing": { "$type": "cubicBezier", "$value": "cubic-bezier(0.2, 0, 0, 1)" }
  },
  "logo": {
    "clear-space": { "$value": "0.33", "$description": "Multiple of mark width = one disc diameter" },
    "mark-min-regular": { "$value": "32px" },
    "mark-min-small-cut": { "$value": "13px" },
    "masthead-min-width": { "$value": "240px" },
    "inline-min-mark": { "$value": "18px" },
    "ball-colour-min": { "$value": "48px", "$description": "Yellow ball disc only at or above this size" }
  },
  "diagram": {
    "unit": {
      "$description": "SVG user units in a 108-unit-wide viewBox (pitch 100 wide + 4 margin each side)",
      "player-radius": { "$value": "4.4" },
      "ghost-radius": { "$value": "4.1" },
      "number-size": { "$value": "4.4" },
      "number-size-two-digit": { "$value": "3.5" },
      "label-size": { "$value": "4.6" },
      "line-label-size": { "$value": "4" },
      "arrow-width": { "$value": "0.95" },
      "pitch-line-width": { "$value": "0.6" },
      "pass-dash": { "$value": "2 1.4" },
      "ghost-dash": { "$value": "1.6 1.2" },
      "area-dash": { "$value": "2 1.2" },
      "ball-radius": { "$value": "1.7" }
    },
    "size": {
      "$type": "dimension",
      "min-numbered-width": { "$value": "280px" },
      "preview-max-width": { "$value": "200px" },
      "print-player-mm": { "$value": "85mm", "$description": "Per-frame width for player-facing PDFs (two across A4)" }
    },
    "theme": {
      "blue": {
        "pitch": { "$value": "{color.pitch-blue}" }, "line": { "$value": "{color.pitch-line}" },
        "us": { "$value": "{color.white}" }, "us-text": { "$value": "{color.pitch-blue}" },
        "them": { "$value": "{color.coral}" }, "them-fill": { "$value": "{color.ink}" }, "them-keyline": { "$value": "{color.white}", "$description": "Outer keyline; carries 3:1 non-text contrast on blue" },
        "ball": { "$value": "{color.space-yellow}" }, "ink": { "$value": "{color.ink}" },
        "space": { "$value": "{color.space-yellow}" }, "space-edge": { "$value": "{color.space-yellow}" }, "space-opacity": { "$value": "0.24" },
        "gap": { "$value": "{color.ink}" }, "gap-edge": { "$value": "{color.coral}" }, "gap-opacity": { "$value": "0.38" },
        "label": { "$value": "{color.white}" }, "halo": { "$value": "{color.pitch-blue}" },
        "mark": { "$value": "{color.space-yellow}" }
      },
      "light": {
        "pitch": { "$value": "{color.white}" }, "line": { "$value": "{color.pitch-line-light}" },
        "us": { "$value": "{color.pitch-blue}" }, "us-text": { "$value": "{color.white}" },
        "them": { "$value": "{color.coral-deep}" }, "them-fill": { "$value": "{color.white}" }, "them-keyline": { "$value": "none" },
        "ball": { "$value": "{color.white}" }, "ink": { "$value": "{color.ink}" },
        "space": { "$value": "{color.space-yellow}" }, "space-edge": { "$value": "{color.space-edge}" }, "space-opacity": { "$value": "0.42" },
        "gap": { "$value": "{color.gap-grey}" }, "gap-edge": { "$value": "{color.gap-grey}" }, "gap-opacity": { "$value": "0.2" },
        "label": { "$value": "{color.ink}" }, "halo": { "$value": "{color.white}" },
        "mark": { "$value": "{color.ink}" }
      },
      "mono": {
        "pitch": { "$value": "{color.white}" }, "line": { "$value": "#B5B5B5" },
        "us": { "$value": "{color.ink}" }, "us-text": { "$value": "{color.white}" },
        "them": { "$value": "{color.ink}" }, "them-fill": { "$value": "{color.white}" }, "them-keyline": { "$value": "none" },
        "ball": { "$value": "{color.white}" }, "ink": { "$value": "{color.ink}" },
        "space": { "$value": "{color.ink}" }, "space-edge": { "$value": "{color.ink}" }, "space-opacity": { "$value": "0.1" },
        "gap": { "$value": "{color.ink}" }, "gap-edge": { "$value": "{color.ink}" }, "gap-opacity": { "$value": "0.28" },
        "label": { "$value": "{color.ink}" }, "halo": { "$value": "{color.white}" },
        "mark": { "$value": "{color.ink}" }
      }
    }
  }
}
